---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const services = [
    {
      id: 'factoring-corporativo',
      title: 'Factoring Corporativo',
      subtitle: 'Conversión de Cuentas por Cobrar',
      price: 'A Medida',
      monthly: null,
      category: 'Liquidez',
      description: "Conversión inmediata de cuentas por cobrar (facturas) en flujo de efectivo para tu empresa.",
      delivery: "Evaluación 24 hrs",
      badge: "ALTA LIQUIDEZ",
      isRecommended: true,
      features: [
        'Adelanto de cuentas por cobrar',
        'Mejora del indicador de liquidez',
        'Sin endeudamiento bancario adicional',
        'Evaluación ágil y tasa competitiva',
        'Asesoría continua de nuestro equipo',
        'Estructuración confidencial'
      ]
    },
    {
      id: 'confirming-proveedores',
      title: 'Confirming (Gestión de Proveedores)',
      subtitle: 'Cadena de Pagos & Tesorería',
      price: 'Línea Corporativa',
      monthly: null,
      category: 'Liquidez',
      description: "Optimización de la cadena de pagos y tesorería corporativa fortaleciendo tu relación con proveedores.",
      delivery: "Estructuración a medida",
      features: [
        'Gestión automatizada de pagos',
        'Financiamiento anticipado a proveedores',
        'Fortalecimiento de la cadena de suministro',
        'Eficiencia en tesorería y flujo de caja',
        'Acompañamiento ejecutivo especialista'
      ]
    },
    {
      id: 'capital-de-trabajo',
      title: 'Financiamiento de Capital de Trabajo',
      subtitle: 'Ciclos Operativos & Crecimiento',
      price: 'Tasa Preferencial',
      monthly: null,
      category: 'Liquidez',
      badge: "PYME & CORP",
      description: "Inyección de liquidez para ciclos operativos, compra de existencias y planes de crecimiento.",
      delivery: "Estructuración ágil",
      features: [
        'Líneas de crédito operacionales',
        'Plazos flexibles según ciclo de negocio',
        'Asesoría en estructura de deuda',
        'Alineado con normas bancarias / CMF',
        'Requisito: Empresas +2 años SII'
      ]
    },
    {
      id: 'leasing-financiero',
      title: 'Leasing Financiero e Inmobiliario',
      subtitle: 'Bienes de Capital con Eficiencia Tributaria',
      price: 'Estructurado',
      monthly: null,
      category: 'Activos',
      badge: "EFICIENCIA TRIBUTARIA",
      isRecommended: true,
      description: "Arrendamiento con opción de compra para bienes de capital, maquinarias e inmuebles con eficiencia tributaria.",
      delivery: "Estructuración integral",
      features: [
        'Financiamiento de largo plazo',
        'Beneficios tributarios directos',
        'Adquisición de maquinaria, flota o inmueble',
        'Opción de compra al final del período',
        'Acompañamiento en due diligence'
      ]
    },
    {
      id: 'leaseback-retrolit',
      title: 'Leaseback (Retrolit)',
      subtitle: 'Monetización de Activos Fijos',
      price: 'Liquidez de Activos',
      monthly: null,
      category: 'Activos',
      description: "Monetización de activos fijos propios para obtener liquidez inmediata manteniendo su operatividad.",
      delivery: "Evaluación patrimonial",
      features: [
        'Conversión de activo fijo en liquidez',
        'Continuidad de uso operativo del bien',
        'Optimización del balance corporativo',
        'Plazos extendidos de amortización',
        'Asesoría legal y patrimonial integral'
      ]
    },
    {
      id: 'creditos-fogain',
      title: 'Créditos con Garantía FOGAIN',
      subtitle: 'Respaldo y Garantías Estatales',
      price: 'Garantía Estatal',
      monthly: null,
      category: 'Garantias',
      badge: "RESPALDO ESTATAL",
      description: "Gestión de financiamiento bancario respaldado por fondos estatales FOGAIN para PYMES y corporaciones.",
      delivery: "Gestión preferente",
      features: [
        'Respaldo de garantía estatal FOGAIN',
        'Mejora en condiciones de tasa y plazo',
        'Acceso para inversiones y capital operacional',
        'Asesoría en postulación y cumplimiento',
        'Atención especial para PYMES solventes'
      ]
    },
    {
      id: 'fianzas-garantias',
      title: 'Fianzas y Certificados de Garantía',
      subtitle: 'Licitaciones y Contratos',
      price: 'Emisión Rápida',
      monthly: null,
      category: 'Garantias',
      description: "Emisión de instrumentos para licitaciones públicas y privadas, contratos y fiel cumplimiento.",
      delivery: "Emisión ágil",
      features: [
        'Certificados para licitaciones y contratos',
        'Garantía de seriedad de oferta y cumplimiento',
        'Sin inmovilizar líneas de crédito bancario',
        'Aceptación en entidades públicas y privadas',
        'Respaldo y solvencia institucional'
      ]
    },
    {
      id: 'seguros-corporativos',
      title: 'Seguros Corporativos',
      subtitle: 'Blindaje Patrimonial & Operativo',
      price: 'Cobertura Integral',
      monthly: null,
      category: 'Garantias',
      description: "Soluciones de cobertura para blindaje patrimonial, responsibility civil y continuidad operativa.",
      delivery: "Diagnóstico 48 hrs",
      features: [
        'Blindaje de activos y patrimonio',
        'Cobertura por interrupción operacional',
        'Seguros de responsabilidad civil y técnicos',
        'Asesoría en gestión integral de riesgo',
        'Acompañamiento ante siniestros'
      ]
    },
    {
      id: 'comercio-exterior-comex',
      title: 'Comercio Exterior (Comex)',
      subtitle: 'Importaciones & Exportaciones',
      price: 'Financiamiento Comex',
      monthly: null,
      category: 'Especializado',
      badge: "IMPORT & EXPORT",
      description: "Estructuración financiera para operaciones de importación y exportación, cartas de crédito y cobranzas.",
      delivery: "Red Internacional",
      features: [
        'Cartas de crédito y cobranzas extranjeras',
        'Financiamiento de importaciones/exportaciones',
        'Cobertura de riesgo cambiario',
        'Estructuración ágil de comercio internacional',
        'Red de bancos corresponsales'
      ]
    },
    {
      id: 'bono-de-riego-cnr',
      title: 'Bono de Riego (Ley CNR)',
      subtitle: 'Eficiencia Hídrica con Beneficio Fiscal',
      price: 'Ley CNR',
      monthly: null,
      category: 'Especializado',
      badge: "BENEFICIO FISCAL",
      description: "Financiamiento especializado para proyectos de eficiencia hídrica y agrícolas acogidos a beneficio fiscal.",
      delivery: "Gestión Ley CNR",
      features: [
        'Financiamiento puente para Ley CNR',
        'Proyectos agrícolas y de eficiencia hídrica',
        'Aprovechamiento del subsidio y bonificación',
        'Asesoría agroeconómica e ingeniería de riego',
        'Evaluación integral del proyecto'
      ]
    },
    {
      id: 'financiamiento-habitacional',
      title: 'Financiamiento Habitacional (SERVIU)',
      subtitle: 'Subsidios & Proyectos Hipotecarios',
      price: 'SERVIU & Hipotecario',
      monthly: null,
      category: 'Especializado',
      description: "Asesoría en la gestión de subsidios y productos hipotecarios específicos habitacionales y de proyectos.",
      delivery: "Asesoría Especializada",
      features: [
        'Gestión de subsidios habitacionales SERVIU',
        'Estructuración de créditos hipotecarios',
        'Evaluación para personas y desarrolladores',
        'Asesoría patrimonial y legal',
        'Requisito: Renta líquida mín. $900.000'
      ]
    }
  ];

  return services.map(service => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Layout title={`${service.title} — ${service.subtitle} | CONFIN CAPITAL`} description={`${service.title} ${service.subtitle}. ${service.price}${service.monthly ? ` + ${service.monthly}` : ''}. Soluciones en finanzas corporativas y capital de CONFIN CAPITAL.`}>
  <Navbar />
  
  <div class="fixed inset-0 z-0 opacity-20 pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-br from-[#1B3C9C]/10 to-transparent"></div>
  </div>

  <main class="min-h-screen pt-32 pb-20 relative z-10 flex items-center">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 w-full">
      
      <div class="mb-10">
        <a href="/tienda" class="inline-flex items-center gap-2 text-black/50 hover:text-black text-sm font-bold tracking-widest uppercase transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Volver a la Tienda
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <!-- Left: Redesigned Card -->
        <div class="fade-up flex justify-center w-full">
          <div 
            class={`w-full max-w-[400px] relative flex flex-col justify-between p-8 min-h-[580px] bg-[#0a0a0a] text-white border ${service.isRecommended ? 'border-[#1B3C9C] shadow-[0_0_25px_rgba(232,0,28,0.15)] scale-[1.02] md:scale-[1.03] z-10' : 'border-white/10'} hover:border-[#1B3C9C]/50 hover:shadow-[0_0_25px_rgba(232,0,28,0.08)]`}
          >
            <div>
              {/* Badge/Tag */}
              <div class="min-h-[28px] mb-4">
                {service.badge && (
                  <span class={`inline-block text-[0.62rem] font-black tracking-widest uppercase px-3 py-1 ${service.isRecommended ? 'bg-[#1B3C9C] text-white font-bold' : 'bg-white/10 text-white/80'}`}>
                    {service.badge}
                  </span>
                )}
              </div>

              {/* Title & Description */}
              <h3 class="text-2xl font-bold tracking-tight text-white mb-2">{service.title}</h3>
              <p class="text-xs text-white/50 leading-relaxed mb-6 font-light">{service.description}</p>

              {/* Price & Delivery */}
              <div class="mb-6 pb-6 border-b border-white/5">
                <div class="flex items-baseline gap-1.5 flex-wrap">
                  <span class="text-4xl font-extrabold tracking-tight text-white">{service.price}</span>
                  {service.monthly && <span class="text-xs font-bold text-white/40 uppercase tracking-wider">{service.monthly}</span>}
                </div>
                {service.delivery && (
                  <div class="text-[0.65rem] text-[#1B3C9C] font-semibold tracking-wider uppercase mt-2">
                    {service.delivery}
                  </div>
                )}
              </div>

              {/* Features List */}
              <ul class="space-y-3 mb-8">
                {service.features.slice(0, 7).map((feature) => {
                  if (feature === '---' || feature.startsWith('+') || feature.startsWith('Todo lo del')) return null;
                  return (
                    <li class="flex items-start gap-2.5 text-xs text-white/70 font-light">
                      <svg class="shrink-0 w-3.5 h-3.5 mt-0.5 text-[#1B3C9C]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  );
                })}
              </ul>
            </div>

            {/* CTA Button */}
            <div class="space-y-2 mt-auto">
              <a 
                href={`https://api.whatsapp.com/send?phone=56920836337&text=Hola,%20me%20gustaría%20cotizar%20el%20servicio:%20${encodeURIComponent(service.title)}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class={`w-full py-3.5 text-center text-xs font-bold uppercase tracking-wider block transition-all ${service.isRecommended ? 'bg-[#1B3C9C] text-white hover:bg-[#122878] shadow-[0_0_15px_rgba(232,0,28,0.4)]' : 'bg-transparent text-white border border-white/20 hover:border-[#1B3C9C] hover:bg-[#1B3C9C]/10'}`}
              >
                Cotizar Ahora ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="flex flex-col fade-up" style="transition-delay: 0.2s">
          <div class="mb-8">
            <span class="saas-badge mb-4 inline-block">{service.category}</span>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-black mb-2 leading-tight">
              {service.title}
            </h1>
            <p class="text-xl text-black/60 font-light">{service.subtitle}</p>
          </div>

          <div class="mb-10 p-6 border border-black/10 rounded-none bg-black/5 backdrop-blur-md">
            <div class="text-3xl font-mono text-black mb-1">{service.price}</div>
            {service.monthly && <div class="text-sm font-bold text-[#1B3C9C] uppercase tracking-widest">+ {service.monthly}</div>}
            {!service.monthly && <div class="text-sm font-bold text-black/40 uppercase tracking-widest">Pago Único</div>}
          </div>

          <h3 class="text-lg font-bold text-black mb-6 tracking-wide uppercase">Características del Plan</h3>
          <ul class="space-y-4 mb-10">
            {service.features.map(feature => {
              if (feature === '---' || feature.startsWith('+') || feature.startsWith('Todo lo del')) {
                return <li class="text-[#1B3C9C] font-bold text-sm uppercase tracking-widest mt-6 mb-2 border-b border-black/10 pb-2">{feature.replace('---', '')}</li>
              }
              return (
                <li class="flex items-start gap-3 text-black/75 font-light">
                  <svg class="shrink-0 mt-1 text-[#1B3C9C]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {feature}
                </li>
              )
            })}
          </ul>

          <a href={`https://api.whatsapp.com/send?phone=56920836337&text=Hola,%20me%20interesa%20adquirir%20el%20servicio:%20${encodeURIComponent(service.title + ' - ' + service.subtitle)}`} target="_blank" rel="noopener noreferrer" class="btn-primary w-full text-center py-5 text-sm">
            Contratar Servicio
          </a>
        </div>

      </div>
    </div>
  </main>
  <Footer />
</Layout>
