---

<Layout title="Catálogo de Servicios — CONFIN CAPITAL" description="Explora nuestras soluciones en finanzas corporativas, estructuración y gestión de inversiones. CONFIN CAPITAL.">
  <Navbar />
  
  <!-- AI Background Image -->
  <div class="fixed inset-0 z-0 opacity-[0.02] pointer-events-none">
    <img src="/images/store_background.png" alt="Store Background" class="w-full h-full object-cover filter invert" />
    <div class="absolute inset-0 bg-gradient-to-b from-white/80 via-transparent to-white"></div>
  </div>

  <main class="min-h-screen pt-32 pb-20 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 lg:px-10">
      
      <!-- Tienda Header -->
      <div class="mb-16 fade-up">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px bg-[var(--saas-brand)] w-16"></div>
          <div class="saas-badge border-none text-[var(--saas-brand)] tracking-[0.2em] text-[0.7rem] px-0 uppercase font-bold">Portal de Adquisición</div>
        </div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter text-black mb-6 leading-[1.1]">
          Servicios <span class="text-transparent bg-clip-text bg-gradient-to-r from-black to-black/40">Oficiales.</span>
        </h1>
        <p class="text-lg text-black/60 max-w-2xl font-light">
          Seleccione y adquiera el servicio tecnológico que mejor se adapte a las necesidades de escalamiento de su empresa.
        </p>
      </div>

      <!-- Filters & Sorting -->
      <div class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-6 mb-12 fade-up">
        
        <!-- Category Pills -->
        <div class="flex flex-wrap items-center gap-2">
          <button class="filter-btn active px-5 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.15em] transition-all bg-[#1B3C9C] text-white border border-[#1B3C9C] shadow-sm" data-filter="all">Todas</button>
          <button class="filter-btn px-5 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.15em] transition-all bg-black/5 text-black/60 border border-black/10 hover:border-black/30 hover:text-black backdrop-blur-md" data-filter="Liquidez">Liquidez & Capital</button>
          <button class="filter-btn px-5 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.15em] transition-all bg-black/5 text-black/60 border border-black/10 hover:border-black/30 hover:text-black backdrop-blur-md" data-filter="Activos">Activos e Inversión</button>
          <button class="filter-btn px-5 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.15em] transition-all bg-black/5 text-black/60 border border-black/10 hover:border-black/30 hover:text-black backdrop-blur-md" data-filter="Garantias">Garantías & FOGAIN</button>
          <button class="filter-btn px-5 py-2.5 rounded-none text-xs font-bold uppercase tracking-[0.15em] transition-all bg-black/5 text-black/60 border border-black/10 hover:border-black/30 hover:text-black backdrop-blur-md" data-filter="Especializado">Especializado & Agrícola</button>
        </div>
        
        <!-- Sorting Segmented Control -->
        <div class="flex items-center p-1 bg-black/5 border border-black/10 rounded-none backdrop-blur-md">
          <button class="sort-btn active px-4 py-2 rounded-none text-[0.65rem] font-bold uppercase tracking-widest transition-all bg-black/10 text-black" data-sort="default">Recomendado</button>
          <button class="sort-btn px-4 py-2 rounded-none text-[0.65rem] font-bold uppercase tracking-widest transition-all text-black/50 hover:text-black" data-sort="asc">Portafolios A-D</button>
        </div>

      </div>

      <!-- Política de Admisión Banner -->
      <div class="mb-12 p-8 bg-[#0a0a0a] border border-[#1B3C9C]/40 text-white fade-up shadow-xl">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2">
            <span class="text-xs font-black tracking-widest uppercase text-[#1B3C9C]">POLÍTICA DE ADMISIÓN & CRITERIOS DE EVALUACIÓN</span>
            <h3 class="text-2xl font-bold">Estándar Institucional de ConFin Capital</h3>
            <p class="text-xs text-white/70 max-w-3xl leading-relaxed">
              Para garantizar condiciones de alta rentabilidad y eficiencia de capital en la negociación de estructuras de financiamiento, aplicamos criterios estrictos de evaluación de solvencia y comportamiento comercial:
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6 pt-6 border-t border-white/10 text-xs">
          <div>
            <h4 class="font-bold text-white mb-2 uppercase tracking-wider text-[#1B3C9C]">Perfil A: Clientes Corporativos (Empresas)</h4>
            <ul class="space-y-1 text-white/75 font-light">
              <li>• <strong class="text-white">Antigüedad Operativa:</strong> Mínimo 2 años ante el SII.</li>
              <li>• <strong class="text-white">Facturación Anual:</strong> Superior a $98.000.000.</li>
              <li>• <strong class="text-white">Situación Fiscal:</strong> Carpeta Tributaria actualizada y certificado TGR sin deudas.</li>
              <li>• <strong class="text-white">Estados Financieros:</strong> 2 últimos Balances Generales y Formulario 22.</li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-white mb-2 uppercase tracking-wider text-[#1B3C9C]">Perfil B: Personas Naturales (Bancarizados & Solventes)</h4>
            <ul class="space-y-1 text-white/75 font-light">
              <li>• <strong class="text-white">Continuidad Laboral:</strong> Mínimo 1 año de antigüedad.</li>
              <li>• <strong class="text-white">Ingresos y Bancarización:</strong> Renta líquida mínima desde $900.000 con cuenta corriente.</li>
              <li>• <strong class="text-white">Comportamiento Comercial:</strong> Historial intachable (Sin Dicom ni morosidades CMF).</li>
              <li>• <strong class="text-white">Patrimonio:</strong> Bienes raíces o vehículos inscritos (Plus).</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Store Grid -->
      <div id="storeGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {storeItems.map((item, i) => (
          <div 
            class={`store-item group relative flex flex-col justify-between transition-all duration-300 p-8 min-h-[580px] bg-[#0a0a0a] text-white border ${item.isRecommended ? 'border-[#1B3C9C] shadow-[0_0_25px_rgba(232,0,28,0.15)] scale-[1.02] md:scale-[1.03] z-10' : 'border-white/10'} hover:border-[#1B3C9C]/50 hover:shadow-[0_0_25px_rgba(232,0,28,0.08)]`}
            data-price={item.price} 
            data-category={item.category} 
            data-original-index={i} 
            style={`transition-delay: ${i * 0.03}s`}
          >
            
            <div>
              {/* Badge/Tag */}
              <div class="min-h-[28px] mb-4">
                {item.badge && (
                  <span class={`inline-block text-[0.62rem] font-black tracking-widest uppercase px-3 py-1 ${item.isRecommended ? 'bg-[#1B3C9C] text-white font-bold' : 'bg-white/10 text-white/80'}`}>
                    {item.badge}
                  </span>
                )}
              </div>

              {/* Title & Description */}
              <h3 class="text-2xl font-bold tracking-tight text-white mb-2">{item.title}</h3>
              <p class="text-xs text-white/50 leading-relaxed mb-6 font-light">{item.description}</p>

              {/* Price & Delivery */}
              <div class="mb-6 pb-6 border-b border-white/5">
                <div class="flex items-baseline gap-1.5 flex-wrap">
                  <span class="text-4xl font-extrabold tracking-tight text-white">{item.priceFormatted}</span>
                  {item.monthly && <span class="text-xs font-bold text-white/40 uppercase tracking-wider">{item.monthly}</span>}
                </div>
                <div class="text-[0.65rem] text-[#1B3C9C] font-semibold tracking-wider uppercase mt-2">
                  {item.delivery}
                </div>
              </div>

              {/* Features List */}
              <ul class="space-y-3 mb-8">
                {item.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-xs text-white/70 font-light">
                    <svg class="shrink-0 w-3.5 h-3.5 mt-0.5 text-[#1B3C9C]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* CTA Buttons */}
            <div class="space-y-2 mt-auto">
              <a 
                href={`https://api.whatsapp.com/send?phone=56920836337&text=Hola,%20me%20gustaría%20cotizar%20el%20servicio:%20${encodeURIComponent(item.title)}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class={`w-full py-3.5 text-center text-xs font-bold uppercase tracking-wider block transition-all ${item.isRecommended ? 'bg-[#1B3C9C] text-white hover:bg-[#122878] shadow-[0_0_15px_rgba(232,0,28,0.4)]' : 'bg-transparent text-white border border-white/20 hover:border-[#1B3C9C] hover:bg-[#1B3C9C]/10'}`}
              >
                Cotizar Ahora ↗
              </a>
              <a 
                href={`/servicio/${item.id}`} 
                class="w-full py-2.5 text-center text-[0.68rem] font-semibold uppercase tracking-widest text-white/40 hover:text-white block transition-colors"
              >
                Ver Detalles del Plan
              </a>
            </div>
            
          </div>
        ))}
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const sortBtns = document.querySelectorAll('.sort-btn');
    const storeGrid = document.getElementById('storeGrid');
    
    if(!storeGrid || filterBtns.length === 0) return;
    
    const items = Array.from(document.querySelectorAll('.store-item'));
    
    let currentCategory = 'all';
    let currentSort = 'default';

    function applyFilters() {
      // Filter
      let visibleItems = items.filter(item => {
        const matchCategory = currentCategory === 'all' || item.getAttribute('data-category') === currentCategory;
        if(matchCategory) {
          item.style.display = 'flex';
          return true;
        } else {
          item.style.display = 'none';
          return false;
        }
      });

      // Sort
      if (currentSort === 'asc') {
        visibleItems.sort((a, b) => parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price')));
      } else if (currentSort === 'desc') {
        visibleItems.sort((a, b) => parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price')));
      } else {
        // default by original index
        visibleItems.sort((a, b) => parseInt(a.getAttribute('data-original-index')) - parseInt(b.getAttribute('data-original-index')));
      }

      // Re-append to grid in new order with animation
      visibleItems.forEach(item => {
        item.style.opacity = '0';
        item.style.transform = 'scale(0.95)';
        storeGrid.appendChild(item);
        
        setTimeout(() => {
          item.style.transition = 'all 0.4s ease';
          item.style.opacity = '1';
          item.style.transform = 'scale(1)';
        }, 50);
      });
    }

    // Category Click Events
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        // Update UI
        filterBtns.forEach(b => {
          b.classList.remove('bg-[#1B3C9C]', 'text-white', 'border-[#1B3C9C]', 'shadow-[0_0_15px_rgba(232,0,28,0.4)]');
          b.classList.add('bg-black/5', 'text-black/60', 'border-black/10');
        });
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.remove('bg-black/5', 'text-black/60', 'border-black/10');
        target.classList.add('bg-[#1B3C9C]', 'text-white', 'border-[#1B3C9C]', 'shadow-[0_0_15px_rgba(232,0,28,0.4)]');
        
        currentCategory = target.getAttribute('data-filter');
        applyFilters();
      });
    });

    // Sort Click Events
    sortBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        // Update UI
        sortBtns.forEach(b => {
          b.classList.remove('bg-black/10', 'text-black');
          b.classList.add('text-black/50');
        });
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.remove('text-black/50');
        target.classList.add('bg-black/10', 'text-black');
        
        currentSort = target.getAttribute('data-sort');
        applyFilters();
      });
    });

  });
</script>
