---
const catalogItems = [
  { id: "agente-ia-whatsapp-estandar", img: "/catalogo/catalog-01.png" },
  { id: "agente-ia-whatsapp-premium", img: "/catalogo/catalog-02.png" },
  { id: "ecommerce-profesional", img: "/catalogo/catalog-03.png" },
  { id: "landing-portal-corporativo", img: "/catalogo/catalog-04.png" },
  { id: "plan-vision-code-pro", img: "/catalogo/catalog-05.png" },
  { id: "ecommerce-basico", img: "/catalogo/catalog-06.png" },
  { id: "ecommerce-intermedio", img: "/catalogo/catalog-07.png" },
  { id: "landing-basica", img: "/catalogo/catalog-08.png" },
];
---

<section id="planes" class="py-32 relative z-10 border-t border-white/5">
  <div class="max-w-[90rem] mx-auto px-6 lg:px-10">
    
    <div class="mb-20 fade-up text-center">
      <div class="saas-badge mb-6 mx-auto">Nuestros Servicios y Precios</div>
      <h2 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight text-white mb-6">
        Catálogo <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/60 to-white/20">Digital.</span>
      </h2>
      <p class="text-lg text-white/50 max-w-2xl mx-auto font-light mb-8">
        Descubra nuestras soluciones tecnológicas, servicios premium y estructuras de inversión diseñadas para escalar su negocio.
      </p>
      <a href="/tienda" class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-[#8B1A2B] text-white text-sm font-bold uppercase tracking-widest hover:bg-white hover:text-[#8B1A2B] transition-colors shadow-lg">
        Ingresar a la Tienda
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Catalog Masonry Grid -->
    <div class="columns-1 md:columns-2 xl:columns-4 gap-8 space-y-8">
      {catalogItems.map((item, i) => (
        <a href={`/servicio/${item.id}`} class="block group relative overflow-hidden rounded-2xl border border-white/10 bg-black/40 fade-up break-inside-avoid shadow-2xl" style={`transition-delay: ${i * 0.1}s`}>
          <img 
            src={item.img} 
            alt={`Catálogo de servicios - Detalles`} 
            class="w-full h-auto transition-all duration-700 group-hover:scale-[1.02] group-hover:opacity-90"
            loading="lazy"
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-2xl pointer-events-none group-hover:ring-white/30 transition-all duration-500"></div>
          
          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <div class="px-6 py-3 rounded-full bg-white/10 border border-white/20 backdrop-blur-md text-white text-sm font-medium tracking-wide transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 flex items-center gap-2 shadow-lg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              Ver Detalles
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
