---
---
<section id="contacto" class="py-32 relative z-10 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="bento-card p-10 md:p-16 fade-up bg-black/60">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Info -->
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="h-px bg-[#8B1A2B] w-12"></div>
            <div class="text-[0.65rem] font-bold uppercase tracking-widest text-[#8B1A2B]">Canal Corporativo</div>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tight mb-6 leading-tight">
            Inicia tu transformación <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8B1A2B] to-white/60">digital hoy mismo.</span>
          </h2>
          <p class="text-sm text-white/60 mb-12 max-w-sm font-light leading-relaxed">
            Solicita una evaluación técnica gratuita con nuestro equipo de ingeniería. Analizaremos tus procesos y diseñaremos una arquitectura orientada a escalar tus ventas.
          </p>
          <div class="flex flex-col gap-6 border-t border-white/10 pt-8">
            <a href="mailto:Vision.code.vs@gmail.com" class="group">
              <div class="text-[0.65rem] font-bold uppercase tracking-widest text-white/40 mb-1">Correo Electrónico</div>
              <div class="text-lg text-white font-medium group-hover:text-[#8B1A2B] transition-colors">Vision.code.vs@gmail.com</div>
            </a>
            <a href="https://wa.me/56929645522" target="_blank" class="group">
              <div class="text-[0.65rem] font-bold uppercase tracking-widest text-white/40 mb-1">Línea Directa (WhatsApp)</div>
              <div class="text-lg text-white font-medium group-hover:text-[#8B1A2B] transition-colors">+56 9 2964 5522</div>
            </a>
          </div>
        </div>

        <!-- Formulario -->
        <div class="bg-black/40 p-8 border border-white/5 rounded-xl backdrop-blur-md shadow-2xl relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-[#8B1A2B]/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          
          <form id="contactForm" class="flex flex-col gap-6 relative z-10">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="relative">
                <label for="empresa" class="text-[10px] font-bold uppercase tracking-widest text-white/50 block mb-2">Empresa o Negocio</label>
                <input type="text" id="empresa" required class="w-full bg-white/5 border border-white/10 rounded-md px-4 py-3 text-sm text-white placeholder:text-white/20 focus:border-[#8B1A2B] focus:bg-black/60 focus:ring-1 focus:ring-[#8B1A2B] outline-none transition-all shadow-inner" placeholder="Ej. Tu Empresa SpA" />
              </div>
              <div class="relative">
                <label for="telefono_empresa" class="text-[10px] font-bold uppercase tracking-widest text-white/50 block mb-2">Teléfono Empresa</label>
                <input type="tel" id="telefono_empresa" required class="w-full bg-white/5 border border-white/10 rounded-md px-4 py-3 text-sm text-white placeholder:text-white/20 focus:border-[#8B1A2B] focus:bg-black/60 focus:ring-1 focus:ring-[#8B1A2B] outline-none transition-all shadow-inner" placeholder="+56 9 XXXX XXXX" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="relative">
                <label for="solicitante" class="text-[10px] font-bold uppercase tracking-widest text-white/50 block mb-2">Nombre Solicitante</label>
                <input type="text" id="solicitante" required class="w-full bg-white/5 border border-white/10 rounded-md px-4 py-3 text-sm text-white placeholder:text-white/20 focus:border-[#8B1A2B] focus:bg-black/60 focus:ring-1 focus:ring-[#8B1A2B] outline-none transition-all shadow-inner" placeholder="Tu nombre" />
              </div>
              <div class="relative">
                <label for="telefono_solicitante" class="text-[10px] font-bold uppercase tracking-widest text-white/50 block mb-2">Tu Teléfono Personal</label>
                <input type="tel" id="telefono_solicitante" required class="w-full bg-white/5 border border-white/10 rounded-md px-4 py-3 text-sm text-white placeholder:text-white/20 focus:border-[#8B1A2B] focus:bg-black/60 focus:ring-1 focus:ring-[#8B1A2B] outline-none transition-all shadow-inner" placeholder="+56 9 XXXX XXXX" />
              </div>
            </div>

            <div class="relative">
              <label for="correo" class="text-[10px] font-bold uppercase tracking-widest text-white/50 block mb-2">Correo Electrónico Corporativo</label>
              <input type="email" id="correo" required class="w-full bg-white/5 border border-white/10 rounded-md px-4 py-3 text-sm text-white placeholder:text-white/20 focus:border-[#8B1A2B] focus:bg-black/60 focus:ring-1 focus:ring-[#8B1A2B] outline-none transition-all shadow-inner" placeholder="contacto@empresa.com" />
            </div>

            <div class="relative">
              <label for="servicio" class="text-[10px] font-bold uppercase tracking-widest text-white/50 block mb-2">Servicio de Interés Principal</label>
              <select id="servicio" required class="w-full bg-white/5 border border-white/10 rounded-md px-4 py-3 text-sm text-white focus:border-[#8B1A2B] focus:bg-black outline-none transition-all appearance-none cursor-pointer">
                <option value="" disabled selected class="bg-gray-900">Seleccione el ecosistema a integrar</option>
                <option value="Landing Page Básica" class="bg-gray-900">Landing Page Básica ($60k)</option>
                <option value="Landing + Portal Corporativo" class="bg-gray-900">Landing + Portal Corporativo ($80k)</option>
                <option value="E-Commerce Básico" class="bg-gray-900">E-Commerce Básico ($150k)</option>
                <option value="E-Commerce Intermedio" class="bg-gray-900">E-Commerce Intermedio ($160k)</option>
                <option value="E-Commerce Profesional" class="bg-gray-900">E-Commerce Profesional ($200k)</option>
                <option value="Plan Vision Code Pro (ERP)" class="bg-gray-900">Plan Vision Code Pro / ERP ($350k)</option>
                <option value="Agente IA WhatsApp (Estándar)" class="bg-gray-900">Agente IA WhatsApp (Estándar)</option>
                <option value="Agente IA WhatsApp (Premium)" class="bg-gray-900">Agente IA WhatsApp (Premium)</option>
                <option value="Consultoría Personalizada" class="bg-gray-900">Consultoría / Desarrollo a Medida</option>
              </select>
              <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none mt-6">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white/40"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>

            <div id="formMsg" class="text-sm hidden"></div>
            <button type="submit" id="submitBtn" class="btn-primary w-full mt-2 text-xs tracking-widest uppercase py-4">
              Enviar Solicitud
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const formMsg = document.getElementById('formMsg') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const empresa = (document.getElementById('empresa') as HTMLInputElement).value;
    const telefono_empresa = (document.getElementById('telefono_empresa') as HTMLInputElement).value;
    const solicitante = (document.getElementById('solicitante') as HTMLInputElement).value;
    const telefono_solicitante = (document.getElementById('telefono_solicitante') as HTMLInputElement).value;
    const correo = (document.getElementById('correo') as HTMLInputElement).value;
    const servicio = (document.getElementById('servicio') as HTMLSelectElement).value;

    submitBtn.textContent = 'Enviando...';
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ empresa, telefono_empresa, solicitante, telefono_solicitante, correo, servicio }),
      });

      if (res.ok) {
        formMsg.textContent = '✅ Solicitud enviada. Te contactaremos a la brevedad.';
        formMsg.className = 'text-sm text-green-400 block';
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      formMsg.textContent = '❌ Error al enviar. Intente nuevamente.';
      formMsg.className = 'text-sm text-red-400 block';
    } finally {
      submitBtn.textContent = 'Enviar Solicitud';
      submitBtn.disabled = false;
    }
  });
</script>
