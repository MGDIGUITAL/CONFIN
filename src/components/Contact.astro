---
---
<section id="contacto" class="py-32 relative z-10 border-t border-black/5 bg-white">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="bento-card p-10 md:p-16 fade-up bg-white">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Info -->
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="h-px bg-[#E8001C] w-12"></div>
            <div class="text-[0.65rem] font-bold uppercase tracking-widest text-[#E8001C]">Canal Corporativo</div>
          </div>
          <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight mb-6 leading-[1.1]">
            Inicia tu transformación <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-black to-black/40">digital hoy mismo.</span>
          </h2>
          <p class="text-sm text-black/60 mb-12 max-w-sm font-light leading-relaxed">
            Solicita una evaluación técnica gratuita con nuestro equipo de ingeniería. Analizaremos tus procesos y diseñaremos una arquitectura orientada a escalar tus ventas.
          </p>
          <div class="flex flex-col gap-6 border-t border-black/10 pt-8">
            <a href="mailto:Vision.code.vs@gmail.com" class="group">
              <div class="text-[0.65rem] font-bold uppercase tracking-widest text-black/40 mb-1">Correo Electrónico</div>
              <div class="text-lg text-black font-medium group-hover:text-[#E8001C] transition-colors">Vision.code.vs@gmail.com</div>
            </a>
            <a href="https://api.whatsapp.com/send?phone=56929645522" target="_blank" class="group">
              <div class="text-[0.65rem] font-bold uppercase tracking-widest text-black/40 mb-1">Línea Directa (WhatsApp)</div>
              <div class="text-lg text-black font-medium group-hover:text-[#E8001C] transition-colors">+56 9 2964 5522</div>
            </a>
          </div>
        </div>

        <!-- Formulario -->
        <div class="bg-neutral-50 p-8 border border-neutral-200/80 rounded-none shadow-sm relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-[#E8001C]/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          
          <form id="contactForm" class="flex flex-col gap-6 relative z-10">
            <!-- Honeypot anti-spam field -->
            <input type="text" id="_honeypot" class="hidden" autocomplete="off" tabindex="-1" />
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="relative">
                <label for="empresa" class="text-[10px] font-bold uppercase tracking-widest text-black/60 block mb-2">Empresa o Negocio</label>
                <input type="text" id="empresa" required class="w-full bg-white border border-neutral-200 rounded-none px-4 py-3 text-sm text-black placeholder:text-neutral-400 focus:border-[#E8001C] focus:bg-white focus:ring-2 focus:ring-[#E8001C]/10 outline-none transition-all shadow-sm" placeholder="Ej. Tu Empresa SpA" />
              </div>
              <div class="relative">
                <label for="telefono_empresa" class="text-[10px] font-bold uppercase tracking-widest text-black/60 block mb-2">Teléfono Empresa</label>
                <input type="tel" id="telefono_empresa" required pattern="^(\+?56)?\s?[92-9]\s?[0-9]{8}$|^[+0-9\s-]{9,15}$" title="Ingrese un número de teléfono válido (ej: +56 9 1234 5678)" class="w-full bg-white border border-neutral-200 rounded-none px-4 py-3 text-sm text-black placeholder:text-neutral-400 focus:border-[#E8001C] focus:bg-white focus:ring-2 focus:ring-[#E8001C]/10 outline-none transition-all shadow-sm" placeholder="+56 9 XXXX XXXX" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="relative">
                <label for="solicitante" class="text-[10px] font-bold uppercase tracking-widest text-black/60 block mb-2">Nombre Solicitante</label>
                <input type="text" id="solicitante" required class="w-full bg-white border border-neutral-200 rounded-none px-4 py-3 text-sm text-black placeholder:text-neutral-400 focus:border-[#E8001C] focus:bg-white focus:ring-2 focus:ring-[#E8001C]/10 outline-none transition-all shadow-sm" placeholder="Tu nombre" />
              </div>
              <div class="relative">
                <label for="telefono_solicitante" class="text-[10px] font-bold uppercase tracking-widest text-black/60 block mb-2">Tu Teléfono Personal</label>
                <input type="tel" id="telefono_solicitante" required pattern="^(\+?56)?\s?[92-9]\s?[0-9]{8}$|^[+0-9\s-]{9,15}$" title="Ingrese un número de teléfono válido (ej: +56 9 1234 5678)" class="w-full bg-white border border-neutral-200 rounded-none px-4 py-3 text-sm text-black placeholder:text-neutral-400 focus:border-[#E8001C] focus:bg-white focus:ring-2 focus:ring-[#E8001C]/10 outline-none transition-all shadow-sm" placeholder="+56 9 XXXX XXXX" />
              </div>
            </div>

            <div class="relative">
              <label for="correo" class="text-[10px] font-bold uppercase tracking-widest text-black/60 block mb-2">Correo Electrónico Corporativo</label>
              <input type="email" id="correo" required class="w-full bg-white border border-neutral-200 rounded-none px-4 py-3 text-sm text-black placeholder:text-neutral-400 focus:border-[#E8001C] focus:bg-white focus:ring-2 focus:ring-[#E8001C]/10 outline-none transition-all shadow-sm" placeholder="contacto@empresa.com" />
            </div>

            <div class="relative">
              <label for="servicio" class="text-[10px] font-bold uppercase tracking-widest text-black/60 block mb-2">Servicio de Interés Principal</label>
              <select id="servicio" required class="w-full bg-white border border-neutral-200 rounded-none px-4 py-3 text-sm text-black focus:border-[#E8001C] focus:bg-white focus:ring-2 focus:ring-[#E8001C]/10 outline-none transition-all appearance-none cursor-pointer">
                <option value="" disabled selected class="bg-white text-neutral-400">Seleccione el ecosistema a integrar</option>
                <option value="Landing Page Básica" class="bg-white text-black">Landing Page Básica ($60k)</option>
                <option value="Landing + Portal Corporativo" class="bg-white text-black">Landing + Portal Corporativo ($80k)</option>
                <option value="E-Commerce Básico" class="bg-white text-black">E-Commerce Básico ($150k)</option>
                <option value="E-Commerce Intermedio" class="bg-white text-black">E-Commerce Intermedio ($160k)</option>
                <option value="E-Commerce Profesional" class="bg-white text-black">E-Commerce Profesional ($200k)</option>
                <option value="Plan Vision Code Pro (ERP)" class="bg-white text-black">Plan Vision Code Pro / ERP ($350k)</option>
                <option value="Agente IA WhatsApp (Estándar)" class="bg-white text-black">Agente IA WhatsApp (Estándar)</option>
                <option value="Agente IA WhatsApp (Premium)" class="bg-white text-black">Agente IA WhatsApp (Premium)</option>
                <option value="Consultoría Personalizada" class="bg-white text-black">Consultoría / Desarrollo a Medida</option>
              </select>
              <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none mt-6">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-black/40"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>

            <div id="formMsg" class="text-sm hidden"></div>
            <button type="submit" id="submitBtn" class="btn-primary w-full mt-2 text-xs tracking-widest uppercase py-4">
              Enviar Solicitud
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const formMsg = document.getElementById('formMsg') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const empresa = (document.getElementById('empresa') as HTMLInputElement).value;
    const telefono_empresa = (document.getElementById('telefono_empresa') as HTMLInputElement).value;
    const solicitante = (document.getElementById('solicitante') as HTMLInputElement).value;
    const telefono_solicitante = (document.getElementById('telefono_solicitante') as HTMLInputElement).value;
    const correo = (document.getElementById('correo') as HTMLInputElement).value;
    const servicio = (document.getElementById('servicio') as HTMLSelectElement).value;
    const _honeypot = (document.getElementById('_honeypot') as HTMLInputElement).value;

    submitBtn.textContent = 'Enviando...';
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ empresa, telefono_empresa, solicitante, telefono_solicitante, correo, servicio, _honeypot }),
      });

      if (res.ok) {
        formMsg.textContent = '✅ Solicitud enviada. Te contactaremos a la brevedad.';
        formMsg.className = 'text-sm text-green-600 font-medium block';
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      formMsg.textContent = '❌ Error al enviar. Intente nuevamente.';
      formMsg.className = 'text-sm text-red-600 font-medium block';
    } finally {
      submitBtn.textContent = 'Enviar Solicitud';
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  input:user-invalid, select:user-invalid {
    border-color: #E8001C !important;
    background-color: rgba(232, 0, 28, 0.02) !important;
  }
</style>
