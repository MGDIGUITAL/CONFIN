---
---
<section id="servicios" class="py-40 relative z-10 overflow-hidden">
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    
    <div class="mb-28 fade-up">
      <div class="flex items-center gap-4 mb-6">
        <div class="h-px bg-[#1B3C9C] w-16"></div>
        <div class="saas-badge border-none text-[#1B3C9C] font-bold tracking-[0.2em] text-[0.7rem] px-0 uppercase">Soluciones de Capital</div>
      </div>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-8 leading-[1.1]">
        La estructura financiera define <br/>
        <span class="h-[1.2em] relative overflow-hidden w-full text-[#1B3C9C] block select-none">
          <span id="rotate-services-text" class="absolute left-0 top-0 w-full h-full flex items-center whitespace-nowrap opacity-0 translate-y-[30px] transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
            el crecimiento de tu empresa.
          </span>
        </span>
      </h2>
      <p class="text-xl text-black/60 max-w-3xl font-light leading-relaxed border-l-2 border-[#1B3C9C] pl-6 shadow-sm">
        Operamos como <strong class="text-black font-bold">puente estratégico e imparcial</strong> entre su necesidad de financiamiento y la entidad financiera idónea. Nuestro modelo de <strong class="text-black font-bold">independencia institucional</strong> nos permite ejecutar un análisis exhaustivo del mercado para diseñar, negociar y gestionar estructuras de crédito, liquidez y cobertura que garanticen la máxima rentabilidad y eficiencia de capital.
      </p>
    </div>

    <!-- Corporate Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 md:auto-rows-[320px] auto-rows-auto">
      
      <!-- Card 1 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 group fade-up bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0s">
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">PORTAFOLIO A</span>
            <h3 class="text-3xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Soluciones de Liquidez & Capital de Trabajo</h3>
            <p class="text-base text-slate-700 leading-relaxed font-normal max-w-xl">
              Optimización inmediata del flujo de caja corporativo mediante <strong class="text-[#122878] font-bold">Factoring Corporativo</strong>, <strong class="text-[#122878] font-bold">Confirming (Gestión de Proveedores)</strong> y líneas de financiamiento de capital de trabajo para potenciar ciclos operativos.
            </p>
          </div>
        </div>
      </article>

      <!-- Card 2 (Span 1) -->
      <article class="bento-card md:col-span-1 p-10 md:p-12 flex flex-col justify-between group fade-up bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0.15s">
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">PORTAFOLIO B</span>
            <h3 class="text-2xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Financiamiento de Activos e Inversión</h3>
            <p class="text-base text-slate-700 leading-relaxed font-normal">Estructuración de <strong class="text-[#122878] font-bold">Leasing Financiero e Inmobiliario</strong> con eficiencia tributaria y <strong class="text-[#122878] font-bold">Leaseback (Retrolit)</strong> para monetizar activos fijos sin perder continuidad operativa.</p>
          </div>
        </div>
      </article>

      <!-- Card 3 (Span 1) -->
      <article class="bento-card md:col-span-1 p-10 md:p-12 flex flex-col justify-between group fade-up bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0.3s">
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">PORTAFOLIO C</span>
            <h3 class="text-2xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Garantías FOGAIN & Coberturas</h3>
            <p class="text-base text-slate-700 leading-relaxed font-normal">Gestión de créditos con <strong class="text-[#122878] font-bold">Garantía Estatal FOGAIN</strong>, emisión de <strong class="text-[#122878] font-bold">Fianzas y Certificados</strong> para licitaciones y <strong class="text-[#122878] font-bold">Seguros Corporativos</strong> de blindaje patrimonial.</p>
          </div>
        </div>
      </article>

      <!-- Card 4 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 group fade-up bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0.45s">
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">PORTAFOLIO D</span>
            <h3 class="text-3xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Financiamiento Especializado & Agrícola</h3>
            <p class="text-base text-slate-700 leading-relaxed font-normal max-w-xl">
              Estructuración financiera para <strong class="text-[#122878] font-bold">Comercio Exterior (Comex)</strong>, proyectos de eficiencia hídrica con <strong class="text-[#122878] font-bold">Bono de Riego (Ley CNR)</strong> y asesoría en productos y subsidios de <strong class="text-[#122878] font-bold">Financiamiento Habitacional (SERVIU)</strong>.
            </p>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  #servicios .bento-card {
    background: #ffffff !important;
    border-color: rgba(27, 60, 156, 0.15) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;
  }
  #servicios .bento-card:hover {
    border-color: rgba(27, 60, 156, 0.45) !important;
    box-shadow: 0 20px 50px rgba(27, 60, 156, 0.15) !important;
  }
</style>

<script>
  import { setupTextRotation } from '../utils/rotator';

  const phrases = [
    "el crecimiento de tu empresa.",
    "la rentabilidad de tu inversión.",
    "la expansión de tus proyectos.",
    "el éxito de tus negocios."
  ];

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupTextRotation('rotate-services-text', phrases, 800);
    });
  } else {
    setupTextRotation('rotate-services-text', phrases, 800);
  }
</script>
