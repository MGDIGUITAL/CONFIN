---
---
<section id="servicios" class="py-40 relative z-10 overflow-hidden">
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    
    <div class="mb-28 fade-up">
      <div class="flex items-center gap-4 mb-6">
        <div class="h-px bg-[#E8001C] w-16"></div>
        <div class="saas-badge border-none text-[#E8001C] font-bold tracking-[0.2em] text-[0.7rem] px-0 uppercase">El Poder de la Visibilidad Digital</div>
      </div>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-8 leading-[1.1]">
        Tu imagen en la web define <br/>
        <span class="h-[1.2em] relative overflow-hidden w-full text-[#E8001C] block select-none">
          <span id="rotate-services-text" class="absolute left-0 top-0 w-full h-full flex items-center whitespace-nowrap opacity-0 translate-y-[30px] transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
            el valor de tu empresa.
          </span>
        </span>
      </h2>
      <p class="text-xl text-black/60 max-w-3xl font-light leading-relaxed border-l-2 border-[#E8001C] pl-6 shadow-sm">
        En el mercado corporativo de hoy, la primera impresión es 100% digital. No tener un ecosistema web optimizado significa cederle clientes a tu competencia cada segundo. <strong class="text-black font-bold">Multiplicamos tu eficiencia, posicionamiento y ventas</strong> a través de ingeniería de código de primer nivel.
      </p>
    </div>

    <!-- Corporate Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 auto-rows-[320px]">
      
      <!-- Card 1 (Span 2) -->
      <article class="bento-card md:col-span-2 p-12 md:p-14 flex flex-col justify-between group fade-up relative overflow-hidden" style="transition-delay: 0s">
        <div class="relative z-10">
          <div class="w-14 h-14 border border-black/10 flex items-center justify-center mb-10 bg-black/5 rounded-lg group-hover:scale-110 transition-transform duration-500 text-black">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <h3 class="text-3xl font-bold text-black mb-5 tracking-tight group-hover:text-[var(--saas-brand)] transition-colors duration-300">Arquitectura Digital Escalable</h3>
          <p class="text-base text-black/60 max-w-xl leading-relaxed font-light">
            Construimos plataformas corporativas diseñadas para manejar millones de peticiones. Mitigamos el riesgo tecnológico de su empresa mediante bases de código sólidas, seguras y preparadas para el futuro.
          </p>
        </div>
      </article>

      <!-- Card 2 (Span 1) -->
      <article class="bento-card md:col-span-1 p-10 md:p-12 flex flex-col justify-between group fade-up bg-[#E8001C]/10 border-[#E8001C]/30 hover:border-[#E8001C]/60 shadow-[0_0_30px_rgba(232,0,28,0.1)] hover:shadow-[0_0_50px_rgba(232,0,28,0.2)]" style="transition-delay: 0.15s">
        <div>
          <div class="w-14 h-14 border border-[#E8001C]/40 flex items-center justify-center mb-10 bg-[#E8001C]/20 text-[#E8001C] rounded-lg group-hover:scale-110 transition-transform duration-500">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 01-8 0"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-black mb-5 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Comercio B2B/B2C</h3>
          <p class="text-base text-black/60 leading-relaxed font-light">Sistemas transaccionales de alto volumen enfocados 100% en maximizar la tasa de conversión y el valor de vida del cliente.</p>
        </div>
      </article>

      <!-- Card 3 (Span 1) -->
      <article class="bento-card md:col-span-1 p-10 md:p-12 flex flex-col justify-between group fade-up" style="transition-delay: 0.3s">
        <div>
          <div class="w-14 h-14 border border-black/10 flex items-center justify-center mb-10 bg-black/5 rounded-lg group-hover:scale-110 transition-transform duration-500 text-black">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-black mb-5 tracking-tight group-hover:text-[var(--saas-brand)] transition-colors duration-300">Consultoría en IA</h3>
          <p class="text-base text-black/60 leading-relaxed font-light">Reducción masiva de costos operativos mediante la integración estratégica de modelos de inteligencia artificial en flujos internos.</p>
        </div>
      </article>

      <!-- Card 4 (Span 2) -->
      <article class="bento-card md:col-span-2 p-12 md:p-14 flex flex-col justify-between group fade-up relative overflow-hidden" style="transition-delay: 0.45s">
        <div class="relative z-10">
          <div class="w-14 h-14 border border-black/10 flex items-center justify-center mb-10 bg-black/5 rounded-lg group-hover:scale-110 transition-transform duration-500 text-black">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
          </div>
          <h3 class="text-3xl font-bold text-black mb-5 tracking-tight group-hover:text-[var(--saas-brand)] transition-colors duration-300">Sistemas ERP & Automatización</h3>
          <p class="text-base text-black/60 max-w-xl leading-relaxed font-light">
            Destruimos la burocracia corporativa centralizando datos. Desarrollamos software de gestión a medida que automatiza procesos manuales, generando un ROI inmediato en ahorro de horas-hombre.
          </p>
        </div>
      </article>

    </div>
  </div>
</section>

<script>
  function initServicesTextRotation() {
    const rotateEl = document.getElementById('rotate-services-text');
    if (!rotateEl) return;

    // Primer reveal del texto
    setTimeout(() => {
      rotateEl.style.opacity = '1';
      rotateEl.style.transform = 'translateY(0)';
    }, 800);

    // Lista de frases a rotar
    const phrases = [
      "el valor de tu empresa.",
      "la confianza de tus clientes.",
      "el futuro de tu negocio.",
      "el éxito de tu marca."
    ];
    let currentIndex = 0;

    function rotateWord() {
      if (!rotateEl) return;
      
      // Deslizar hacia arriba y desaparecer
      rotateEl.style.opacity = '0';
      rotateEl.style.transform = 'translateY(-30px)';
      
      setTimeout(() => {
        // Cambiar palabra y reposicionar abajo
        currentIndex = (currentIndex + 1) % phrases.length;
        rotateEl.textContent = phrases[currentIndex];
        rotateEl.style.transform = 'translateY(30px)';
        
        // Transición de entrada
        requestAnimationFrame(() => {
          setTimeout(() => {
            rotateEl.style.opacity = '1';
            rotateEl.style.transform = 'translateY(0)';
          }, 50);
        });
      }, 500);
    }

    // Iniciar el ciclo de rotación
    setTimeout(() => {
      setInterval(rotateWord, 3200);
    }, 1500);
  }

  // Inicializar al cargar el DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initServicesTextRotation();
    });
  } else {
    initServicesTextRotation();
  }
</script>
