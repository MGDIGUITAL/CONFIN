---
---
<section id="servicios" class="py-40 relative z-10 overflow-hidden">
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    
    <div class="mb-28 fade-up">
      <div class="flex items-center gap-4 mb-6">
        <div class="h-px bg-[#E8001C] w-16"></div>
        <div class="saas-badge border-none text-[#E8001C] font-bold tracking-[0.2em] text-[0.7rem] px-0 uppercase">Tecnología para Crecer</div>
      </div>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-8 leading-[1.1]">
        Tu presencia en la web define <br/>
        <span class="h-[1.2em] relative overflow-hidden w-full text-[#E8001C] block select-none">
          <span id="rotate-services-text" class="absolute left-0 top-0 w-full h-full flex items-center whitespace-nowrap opacity-0 translate-y-[30px] transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
            el futuro de tu negocio.
          </span>
        </span>
      </h2>
      <p class="text-xl text-black/60 max-w-3xl font-light leading-relaxed border-l-2 border-[#E8001C] pl-6 shadow-sm">
        Hoy, si tu negocio no está en internet de forma profesional, no existe. Creamos herramientas digitales rápidas y atractivas que <strong class="text-black font-bold">capturan visitas, generan confianza y multiplican las ventas</strong> de tu negocio automáticamente.
      </p>
    </div>

    <!-- Corporate Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 md:auto-rows-[320px] auto-rows-auto">
      
      <!-- Card 1 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 group fade-up bg-[#0a0a0a] border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0s">
        <!-- Background Graphic -->
        <div class="absolute inset-0 bg-cover bg-center grayscale opacity-25 group-hover:opacity-45 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 pointer-events-none" style="background-image: url('/images/service-architecture-new.png');"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-[#0a0a0a] via-[#0a0a0a]/85 to-transparent pointer-events-none"></div>

        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-3xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Páginas Web Profesionales</h3>
            <p class="text-base text-white/60 leading-relaxed font-light max-w-xl">
              Creamos sitios web modernos, rápidos y atractivos que capturan la esencia de tu marca. Diseñados para verse perfectos en celulares y computadoras, ganando la confianza de tus clientes al instante.
            </p>
          </div>
        </div>
      </article>

      <!-- Card 2 (Span 1) - Dark Contrast Card -->
      <article class="bento-card md:col-span-1 p-10 md:p-12 flex flex-col justify-between group fade-up bg-[#0a0a0a] border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0.15s">
        <!-- Background Graphic -->
        <div class="absolute inset-0 bg-cover bg-center grayscale opacity-25 group-hover:opacity-45 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 pointer-events-none" style="background-image: url('/images/service-ecommerce-new.png');"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-[#0a0a0a] via-[#0a0a0a]/85 to-transparent pointer-events-none"></div>

        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-2xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Tiendas Online (E-Commerce)</h3>
            <p class="text-base text-white/60 leading-relaxed font-light">Vende tus productos o servicios en internet de forma automática. Diseñamos tiendas fáciles de usar y con sistemas de pago integrados para recibir dinero directo en tu cuenta bancaria.</p>
          </div>
        </div>
      </article>

      <!-- Card 3 (Span 1) -->
      <article class="bento-card md:col-span-1 p-10 md:p-12 flex flex-col justify-between group fade-up bg-[#0a0a0a] border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0.3s">
        <!-- Background Graphic -->
        <div class="absolute inset-0 bg-cover bg-center grayscale opacity-25 group-hover:opacity-45 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 pointer-events-none" style="background-image: url('/images/service-ai-new.png');"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-[#0a0a0a] via-[#0a0a0a]/85 to-transparent pointer-events-none"></div>

        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-2xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">WhatsApp & Chatbots con IA</h3>
            <p class="text-base text-white/60 leading-relaxed font-light">Atiende y vende 24/7 sin contratar personal extra. Asistentes virtuales inteligentes que responden de inmediato a tus clientes a través de WhatsApp y de tu sitio web.</p>
          </div>
        </div>
      </article>

      <!-- Card 4 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 group fade-up bg-[#0a0a0a] border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 relative overflow-hidden" style="transition-delay: 0.45s">
        <!-- Background Graphic -->
        <div class="absolute inset-0 bg-cover bg-center grayscale opacity-25 group-hover:opacity-45 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 pointer-events-none" style="background-image: url('/images/service-erp-new.png');"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-[#0a0a0a] via-[#0a0a0a]/85 to-transparent pointer-events-none"></div>

        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-3xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Sistemas y Automatizaciones</h3>
            <p class="text-base text-white/60 leading-relaxed font-light max-w-xl">
              Elimina el papeleo y las tareas manuales repetitivas. Diseñamos sistemas a medida que conectan tu negocio y controlan tus procesos automáticamente para ahorrarte valiosas horas de trabajo cada día.
            </p>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<script>
  import { setupTextRotation } from '../utils/rotator';

  const phrases = [
    "el futuro de tu negocio.",
    "la confianza de tus clientes.",
    "el nivel de tus ventas.",
    "el éxito de tu marca."
  ];

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupTextRotation('rotate-services-text', phrases, 800);
    });
  } else {
    setupTextRotation('rotate-services-text', phrases, 800);
  }
</script>
