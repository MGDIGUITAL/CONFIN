---
const steps = [
  { 
    num: "01", 
    title: "Diagnóstico Financiero", 
    desc: "Analizamos en detalle su situación financiera, necesidad de capital y perfil de riesgo para identificar la estructura de financiamiento más eficiente y competitiva del mercado.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>`
  },
  { 
    num: "02", 
    title: "Evaluación de Admisión", 
    desc: "Verificamos el cumplimiento de los criterios institucionales (antigüedad SII, facturación, comportamiento comercial CMF/Dicom) para garantizar la viabilidad de la operación antes de presentarla.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>`
  },
  { 
    num: "03", 
    title: "Diseño de Solución", 
    desc: "Diseñamos la estructura de financiamiento óptima y preparamos la carpeta documental exacta que cada entidad requiere, eliminando rondas de corrección que consumen tiempo crítico.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>`
  },
  { 
    num: "04", 
    title: "Negociación & Gestión", 
    desc: "Presentamos la operación simultáneamente a múltiples entidades financieras, presionando por plazos de respuesta ágiles y negociando activamente las condiciones más competitivas en tasa, plazo y garantías.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`
  },
  { 
    num: "05", 
    title: "Cierre & Acompañamiento", 
    desc: "Supervisamos el cierre formal de la operación y permanecemos como aliado estratégico para monitorear el desempeño financiero y anticipar necesidades futuras de capital o cobertura.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>`
  },
];
---

<section id="proceso" class="py-40 relative z-10 border-t border-black/5 bg-[#fafafa]">
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 relative items-start">
      
      <!-- Sticky Left Side -->
      <div class="lg:col-span-5 lg:sticky lg:top-32 fade-up">
        <div class="flex items-center gap-4 mb-4">
          <div class="h-px bg-[#1B3C9C] w-12"></div>
          <div class="saas-badge border-none text-[#1B3C9C] font-bold tracking-widest text-[0.65rem] px-0 uppercase">Proceso Transparente</div>
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-6 leading-[1.1]">
          Cómo <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-black to-black/40">gestionamos.</span>
        </h2>
        <p class="text-lg text-black/60 leading-relaxed max-w-sm font-light">
          Diseñamos una ruta de gestión clara y transparente para asegurar que su estructura de financiamiento se formalice con la máxima agilidad, al mejor costo y sin sorpresas documentales.
        </p>
        <div class="mt-8 p-5 bg-black/5 border border-black/10">
          <p class="text-xs text-black/50 leading-relaxed font-light">
            <strong class="text-black font-semibold uppercase tracking-wider text-[0.65rem]">Independencia Institucional</strong><br/>
            No nos vinculamos públicamente a entidades bancarias específicas. Esto nos permite ejecutar un análisis exhaustivo y objetivo del mercado para cada operación.
          </p>
        </div>
      </div>

      <!-- Scrolling Right Side with Timeline -->
      <div class="lg:col-span-7 relative flex flex-col gap-12 pt-8 lg:pt-0 pl-4 lg:pl-0">
        <!-- Vertical timeline line -->
        <div class="absolute left-6 lg:left-8 top-4 bottom-4 w-px bg-black/5" aria-hidden="true">
          <div id="timeline-progress" class="w-full bg-gradient-to-b from-[#1B3C9C] to-[#1B3C9C]/40 h-0 transition-all duration-300 origin-top"></div>
        </div>
        
        {steps.map((step, i) => (
          <div class="relative group fade-up" style={`transition-delay: ${i * 0.15}s`}>
            
            <!-- Timeline bullet -->
            <div class="absolute left-[21px] lg:left-[29px] top-10 -translate-x-1/2 w-3.5 h-3.5 rounded-full border-2 border-black bg-white group-hover:border-[#1B3C9C] group-hover:bg-[#1B3C9C] group-hover:scale-125 transition-all duration-300 z-20"></div>
            
            <!-- Card -->
            <div class="ml-12 lg:ml-16 bg-white border border-black/5 p-8 lg:p-10 rounded-none shadow-sm hover:shadow-md hover:border-black/10 transition-all duration-500 relative overflow-hidden">
              <!-- Big architectural background number -->
              <div class="text-[5.5rem] leading-none font-black absolute top-2 right-6 select-none opacity-25 group-hover:opacity-40 transition-opacity duration-500 font-outline pointer-events-none">
                {step.num}
              </div>

              <div class="relative z-10">
                <!-- Icon and Title Row -->
                <div class="flex items-center gap-4 mb-4">
                  <div class="w-11 h-11 border border-black/5 flex items-center justify-center bg-black/5 rounded-none text-[#1B3C9C] group-hover:bg-[#1B3C9C] group-hover:text-white transition-all duration-300 shadow-sm">
                    <Fragment set:html={step.icon} />
                  </div>
                  <h3 class="text-xl font-bold text-black tracking-tight">{step.title}</h3>
                </div>
                
                <p class="text-sm text-black/60 leading-relaxed font-light max-w-lg">
                  {step.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .font-outline {
    -webkit-text-stroke: 1.5px rgba(27, 60, 156, 0.2);
    color: transparent;
    transition: -webkit-text-stroke 0.4s ease;
  }
  .group:hover .font-outline {
    -webkit-text-stroke: 1.5px rgba(27, 60, 156, 0.4);
  }
</style>

<script>
  function initTimelineProgress() {
    const section = document.getElementById('proceso');
    const progressBar = document.getElementById('timeline-progress');
    if (!section || !progressBar) return;

    window.addEventListener('scroll', () => {
      const rect = section.getBoundingClientRect();
      const sectionHeight = rect.height;
      const scrollOffset = -rect.top;
      
      // Calculate scroll progress percentage (from 0 to 100)
      let progress = (scrollOffset / (sectionHeight - window.innerHeight)) * 100;
      progress = Math.max(0, Math.min(100, progress));
      
      progressBar.style.height = `${progress}%`;
    }, { passive: true });
  }

  // Initialize at DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelineProgress);
  } else {
    initTimelineProgress();
  }
</script>
