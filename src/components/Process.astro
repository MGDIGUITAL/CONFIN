---
const steps = [
  { 
    num: "01", 
    title: "Análisis Inicial", 
    desc: "Estudiamos tu negocio de forma personalizada para entender cómo trabajas, encontrar tareas lentas que se puedan automatizar y diseñar el plan de acción perfecto.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>`
  },
  { 
    num: "02", 
    title: "Diseño y Estructura", 
    desc: "Creamos los bocetos visuales y definimos la estructura del sitio para que sea sumamente fácil de navegar y guíe a tus visitas directo a comprar tus servicios.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect><path d="M7 12v4M17 8v4M10 8h4M7 5h7M7 19h7"></path></svg>`
  },
  { 
    num: "03", 
    title: "Desarrollo y Programación", 
    desc: "Programamos tu sitio con código limpio, rápido y seguro. Podrás ver y probar los avances del proyecto en tiempo real mientras lo construimos.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline><line x1="14" y1="4" x2="10" y2="20"></line></svg>`
  },
  { 
    num: "04", 
    title: "Pruebas de Calidad", 
    desc: "Revisamos minuciosamente que todo funcione a la perfección en computadoras, celulares y tablets, garantizando una carga rápida y máxima seguridad.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M12 8v4M12 16h.01"></path></svg>`
  },
  { 
    num: "05", 
    title: "Lanzamiento y Entrega", 
    desc: "Publicamos tu sitio en internet sin interrumpir tus operaciones. Te enseñamos a usarlo paso a paso para que tengas el control total de tu negocio.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>`
  },
];
---

<section id="proceso" class="py-40 relative z-10 border-t border-black/5 bg-[#fafafa]">
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 relative items-start">
      
      <!-- Sticky Left Side -->
      <div class="lg:col-span-5 lg:sticky lg:top-32 fade-up">
        <div class="flex items-center gap-4 mb-4">
          <div class="h-px bg-[#E8001C] w-12"></div>
          <div class="saas-badge border-none text-[#E8001C] font-bold tracking-widest text-[0.65rem] px-0 uppercase">Proceso Transparente</div>
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-6 leading-[1.1]">
          Cómo <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-black to-black/40">trabajamos.</span>
        </h2>
        <p class="text-lg text-black/60 leading-relaxed max-w-sm font-light">
          Diseñamos una ruta de trabajo clara y transparente para garantizar que tu proyecto se entregue a tiempo, sin sorpresas y listo para vender.
        </p>
      </div>

      <!-- Scrolling Right Side with Timeline -->
      <div class="lg:col-span-7 relative flex flex-col gap-12 pt-8 lg:pt-0 pl-4 lg:pl-0">
        <!-- Vertical timeline line -->
        <div class="absolute left-6 lg:left-8 top-4 bottom-4 w-px bg-black/5" aria-hidden="true">
          <div id="timeline-progress" class="w-full bg-gradient-to-b from-[#E8001C] to-[#E8001C]/40 h-0 transition-all duration-300 origin-top"></div>
        </div>
        
        {steps.map((step, i) => (
          <div class="relative group fade-up" style={`transition-delay: ${i * 0.15}s`}>
            
            <!-- Timeline bullet -->
            <div class="absolute left-[21px] lg:left-[29px] top-10 -translate-x-1/2 w-3.5 h-3.5 rounded-full border-2 border-black bg-white group-hover:border-[#E8001C] group-hover:bg-[#E8001C] group-hover:scale-125 transition-all duration-300 z-20"></div>
            
            <!-- Card -->
            <div class="ml-12 lg:ml-16 bg-white border border-black/5 p-8 lg:p-10 rounded-none shadow-sm hover:shadow-md hover:border-black/10 transition-all duration-500 relative overflow-hidden">
              <!-- Big architectural background number -->
              <div class="text-[5.5rem] leading-none font-black absolute top-2 right-6 select-none opacity-25 group-hover:opacity-40 transition-opacity duration-500 font-outline pointer-events-none">
                {step.num}
              </div>

              <div class="relative z-10">
                <!-- Icon and Title Row -->
                <div class="flex items-center gap-4 mb-4">
                  <div class="w-11 h-11 border border-black/5 flex items-center justify-center bg-black/5 rounded-none text-[#E8001C] group-hover:bg-[#E8001C] group-hover:text-white transition-all duration-300 shadow-sm">
                    <Fragment set:html={step.icon} />
                  </div>
                  <h3 class="text-xl font-bold text-black tracking-tight">{step.title}</h3>
                </div>
                
                <p class="text-sm text-black/60 leading-relaxed font-light max-w-lg">
                  {step.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .font-outline {
    -webkit-text-stroke: 1.5px rgba(232, 0, 28, 0.2);
    color: transparent;
    transition: -webkit-text-stroke 0.4s ease;
  }
  .group:hover .font-outline {
    -webkit-text-stroke: 1.5px rgba(232, 0, 28, 0.4);
  }
</style>

<script>
  function initTimelineProgress() {
    const section = document.getElementById('proceso');
    const progressBar = document.getElementById('timeline-progress');
    if (!section || !progressBar) return;

    window.addEventListener('scroll', () => {
      const rect = section.getBoundingClientRect();
      const sectionHeight = rect.height;
      const scrollOffset = -rect.top;
      
      // Calculate scroll progress percentage (from 0 to 100)
      let progress = (scrollOffset / (sectionHeight - window.innerHeight)) * 100;
      progress = Math.max(0, Math.min(100, progress));
      
      progressBar.style.height = `${progress}%`;
    }, { passive: true });
  }

  // Initialize at DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelineProgress);
  } else {
    initTimelineProgress();
  }
</script>
