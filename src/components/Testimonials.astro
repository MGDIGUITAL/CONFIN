---
const testimonials = [
  {
    name: "Sebastián Valdés",
    role: "Director Comercial, Grupo Retail",
    text: "La migración de nuestro sistema e-commerce fue impecable. Vision Code entendió exactamente la arquitectura corporativa que necesitábamos para escalar sin caídas de servidor."
  },
  {
    name: "Valentina Rojas",
    role: "Gerente de Operaciones, Logistics Chile",
    text: "El desarrollo del ERP interno nos permitió reducir un 40% del trabajo manual. Es raro encontrar una firma tecnológica que cumpla con los plazos exactos."
  },
  {
    name: "Ignacio Soto",
    role: "CEO, Inmobiliaria Austral",
    text: "Diseño de altísimo nivel. El portal web que construyeron proyecta la confianza exacta que nuestro mercado inmobiliario exige."
  },
  {
    name: "Catalina Undurraga",
    role: "Directora de Innovación",
    text: "Integrar soluciones automatizadas siempre es un riesgo, pero el equipo de Vision Code demostró una maestría técnica que superó nuestras expectativas."
  },
  {
    name: "Felipe Echeverría",
    role: "Founder, FinTech Latam",
    text: "Arquitectura sólida, código limpio y una comunicación directa. Es nuestra consultora de desarrollo de cabecera para proyectos críticos."
  },
  {
    name: "Marcos Villanueva",
    role: "Director de Marketing, AutoMundo",
    text: "Teníamos un diseño web muy básico. Vision Code nos entregó una plataforma premium y un sistema interno que automatizó la atención de clientes 24/7."
  },
  {
    name: "Andrea Ferrer",
    role: "Fundadora, E-Commerce B2C",
    text: "Multiplicamos nuestras ventas drásticamente gracias a la optimización de conversión (CRO) y la velocidad de carga extrema de nuestra nueva tienda."
  },
  {
    name: "Javier Cifuentes",
    role: "Gerente de Innovación TI",
    text: "La implementación de los agentes de Inteligencia Artificial en nuestro WhatsApp corporativo filtró el 60% de consultas, ahorrando muchísimo tiempo."
  }
];
---

<section id="clientes" class="py-32 relative z-10 border-t border-black/5 bg-[#F6F6F6] overflow-hidden">

  <!-- Glow ambiental de fondo -->
  <div class="testimonials-glow" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Header editorial -->
    <div class="mb-16 testimonials-header">
      <div class="flex items-center gap-4 mb-6">
        <div class="h-px bg-gradient-to-r from-[#E8001C]/60 to-transparent w-16"></div>
        <span class="saas-badge border-none text-white/40 tracking-[0.18em] text-[0.6rem] px-0 uppercase">
          Confianza Corporativa
        </span>
      </div>

      <h2 class="testimonials-heading">
        Respaldados por<br/>
        <span class="testimonials-heading-accent">quienes lideran.</span>
      </h2>

      <p class="testimonials-subtext">
        Empresas que confiaron en nuestra ingeniería para sus sistemas más críticos.
      </p>
    </div>

    <!-- Carrusel -->
    <div class="relative">
      <div
        class="testimonials-track scrollbar-hide cursor-grab active:cursor-grabbing"
        id="testimonial-slider"
        role="list"
        aria-label="Testimonios de clientes"
      >
        {testimonials.map((t, i) => (
          <article
            class="testimonials-card snap-start"
            role="listitem"
            style={`--delay: ${i * 80}ms`}
          >
            <!-- Comilla decorativa -->
            <div class="testimonials-quote" aria-hidden="true">
              <svg width="28" height="22" viewBox="0 0 28 22" fill="none">
                <path d="M0 22V13.5C0 9.167 1.417 5.75 4.25 3.25C7.083 0.75 10.667 -0.167 15 0.167L14 3C11.667 3 9.75 3.833 8.25 5.5C6.75 7.167 6 9.333 6 12H12V22H0ZM16 22V13.5C16 9.167 17.417 5.75 20.25 3.25C23.083 0.75 26.667 -0.167 31 0.167L30 3C27.667 3 25.75 3.833 24.25 5.5C22.75 7.167 22 9.333 22 12H28V22H16Z" fill="currentColor"/>
              </svg>
            </div>

            <!-- Texto del testimonio -->
            <p class="testimonials-text">"{t.text}"</p>

            <!-- Separador -->
            <div class="testimonials-divider" aria-hidden="true"></div>

            <!-- Autor -->
            <footer class="testimonials-author">
              <!-- Inicial avatar -->
              <div class="testimonials-avatar" aria-hidden="true">
                {t.name.charAt(0)}
              </div>
              <div>
                <div class="testimonials-name">{t.name}</div>
                <div class="testimonials-role">{t.role}</div>
              </div>
            </footer>
          </article>
        ))}
      </div>

      <!-- Fade lateral derecho -->
      <div class="testimonials-fade-right" aria-hidden="true"></div>
    </div>

    <!-- Dots de progreso -->
    <div class="testimonials-dots" id="testimonial-dots" role="tablist" aria-label="Navegación del carrusel">
      {testimonials.map((_, i) => (
        <button
          class={`testimonials-dot ${i === 0 ? 'active' : ''}`}
          data-index={i}
          role="tab"
          aria-selected={i === 0}
          aria-label={`Testimonio ${i + 1}`}
        ></button>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Glow ambiental ── */
  .testimonials-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(232, 0, 28, 0.07) 0%, transparent 70%);
    pointer-events: none;
    filter: blur(40px);
  }

  /* ── Header animado ── */
  .testimonials-header {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .testimonials-header.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Heading editorial ── */
  .testimonials-heading {
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #0a0a0a;
    margin: 0 0 1rem 0;
  }

  .testimonials-heading-accent {
    background: linear-gradient(
      135deg,
      #0a0a0a 0%,
      #E8001C 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .testimonials-subtext {
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.55);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.6;
    margin: 0;
    max-width: 40ch;
  }

  /* ── Carrusel track ── */
  .testimonials-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 1.5rem;
  }

  /* Ocultar scrollbar */
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  /* Fade lateral derecho */
  .testimonials-fade-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: calc(100% - 1.5rem);
    background: linear-gradient(to right, transparent, #F6F6F6);
    pointer-events: none;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  /* ── Card ── */
  .testimonials-card {
    flex-shrink: 0;
    width: 85vw;
    max-width: 400px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    border-radius: 0.5rem;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    overflow: hidden;
    transition:
      border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);

    /* Reveal staggered */
    opacity: 0;
    transform: translateY(20px);
  }

  .testimonials-card.in-view {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--delay, 0ms);
  }

  /* Borde superior de acento al hacer hover */
  .testimonials-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(232, 0, 28, 0.5), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .testimonials-card:hover {
    border-color: rgba(232, 0, 28, 0.3);
    background: #ffffff;
    transform: translateY(-3px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  .testimonials-card:hover::before { opacity: 1; }

  /* ── Comilla ── */
  .testimonials-quote {
    color: rgba(232, 0, 28, 0.45);
    line-height: 1;
    flex-shrink: 0;
  }

  /* ── Texto ── */
  .testimonials-text {
    font-size: 0.9rem;
    line-height: 1.75;
    color: rgba(0, 0, 0, 0.72);
    font-weight: 300;
    letter-spacing: 0.005em;
    margin: 0;
    flex: 1;
  }

  /* ── Separador ── */
  .testimonials-divider {
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0.08), transparent);
  }

  /* ── Autor ── */
  .testimonials-author {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .testimonials-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(232, 0, 28, 0.2);
    border: 1px solid rgba(232, 0, 28, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(200, 80, 90, 0.9);
    flex-shrink: 0;
    letter-spacing: 0;
  }

  .testimonials-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: #0a0a0a;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .testimonials-role {
    font-size: 0.7rem;
    color: rgba(0, 0, 0, 0.50);
    margin-top: 0.2rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  /* ── Dots de progreso ── */
  .testimonials-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .testimonials-dot {
    width: 20px;
    height: 2px;
    border: none;
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.15);
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease, width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .testimonials-dot.active {
    width: 36px;
    background: rgba(232, 0, 28, 0.8);
  }

  .testimonials-dot:hover:not(.active) {
    background: rgba(255, 255, 255, 0.3);
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .testimonials-card {
      width: 400px;
    }
  }
</style>

<script>
  // ── Drag to scroll (desktop) ──────────────────────────────────
  const slider = document.getElementById('testimonial-slider');
  const dots = document.querySelectorAll('.testimonials-dot');

  let isDown = false;
  let startX: number;
  let scrollLeft: number;
  let isDragging = false;

  if (slider) {
    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      isDragging = false;
      startX = (e as MouseEvent).pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
      slider.style.userSelect = 'none';
    });

    slider.addEventListener('mouseleave', () => { isDown = false; });
    slider.addEventListener('mouseup', () => {
      isDown = false;
      slider.style.userSelect = '';
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      isDragging = true;
      const x = (e as MouseEvent).pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.8;
      slider.scrollLeft = scrollLeft - walk;
    });

    // ── Dots sincronizados con scroll ──────────────────────────
    const updateDots = () => {
      const cardWidth = slider.scrollWidth / dots.length;
      const activeIndex = Math.round(slider.scrollLeft / cardWidth);
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === activeIndex);
        dot.setAttribute('aria-selected', String(i === activeIndex));
      });
    };

    slider.addEventListener('scroll', updateDots, { passive: true });

    // Click en dots → scroll suave
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const cardWidth = slider.scrollWidth / dots.length;
        slider.scrollTo({ left: cardWidth * i, behavior: 'smooth' });
        resetAutoPlay();
      });
    });

    // ── Auto-play feature ───────────────────────────────────────
    let autoPlayInterval;
    const startAutoPlay = () => {
      autoPlayInterval = setInterval(() => {
        if (!isDown) {
          const cardWidth = slider.scrollWidth / dots.length;
          let nextScroll = slider.scrollLeft + cardWidth;
          // Check if we hit the end (accounting for client width)
          if (nextScroll >= slider.scrollWidth - slider.clientWidth - 10) {
            nextScroll = 0;
          }
          slider.scrollTo({ left: nextScroll, behavior: 'smooth' });
        }
      }, 3500);
    };

    const resetAutoPlay = () => {
      clearInterval(autoPlayInterval);
      startAutoPlay();
    };

    startAutoPlay(); // Start on load

    // Pause auto-play on hover so users can read
    slider.addEventListener('mouseenter', () => clearInterval(autoPlayInterval));
    slider.addEventListener('mouseleave', () => {
      if (!isDown) startAutoPlay();
    });
  }

  // ── Reveal staggered de cards con IntersectionObserver ────────
  const cards = document.querySelectorAll('.testimonials-card');
  const header = document.querySelector('.testimonials-header');

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  if (header) revealObserver.observe(header);
  cards.forEach(card => revealObserver.observe(card));
</script>
