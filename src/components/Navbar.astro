---
const links = [
  { text: "Inicio", href: "/#inicio" },
  { text: "Soluciones", href: "/#servicios" },
  { text: "Impacto Digital", href: "/#impacto" },
  { text: "Clientes", href: "/#clientes" },
  { text: "Servicios", href: "/tienda" },
];
---

<header class="fixed w-full top-0 z-50 flex flex-col" id="navbar">
  <!-- Línea roja superior -->
  <div class="h-[3px] w-full bg-[#E8001C]"></div>

  <!-- TOP BAR (White background, desktop only) -->
  <div class="hidden md:flex bg-white text-black border-b border-black/5 py-1 px-8 justify-between items-center w-full min-h-[75px] relative">
    <!-- Left: Contact Details -->
    <div class="flex items-center gap-6 text-[0.68rem] font-bold uppercase tracking-wider text-black/70">
      <a href="https://api.whatsapp.com/send?phone=56929645522" target="_blank" class="flex items-center gap-2 hover:text-[#E8001C] transition-colors">
        <svg class="w-3.5 h-3.5 text-[#E8001C]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.94-6.94l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
        </svg>
        +56 9 2964 5522
      </a>
      <a href="mailto:Vision.code.vs@gmail.com" class="flex items-center gap-2 hover:text-[#E8001C] transition-colors">
        <svg class="w-3.5 h-3.5 text-[#E8001C]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
        </svg>
        Vision.code.vs@gmail.com
      </a>
    </div>

    <!-- Center: Brand Logo (Black version for white background) -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center h-full">
      <a href="/#inicio" class="block h-full flex items-center justify-center">
        <img 
          src="/images/logosinfondonegro.png" 
          alt="VisionCode Logo" 
          class="h-[140px] w-auto object-contain my-[-45px] scale-[1.1] relative z-10 translate-y-6"
        />
      </a>
    </div>

    <!-- Right: Social Links -->
    <div class="flex items-center gap-4">
      <a href="https://instagram.com" target="_blank" class="text-black/70 hover:text-[#E8001C] transition-colors" aria-label="Instagram">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>
      <a href="https://linkedin.com" target="_blank" class="text-black/70 hover:text-[#E8001C] transition-colors" aria-label="LinkedIn">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- MAIN NAVIGATION BAR (Black background) -->
  <div class="bg-[#0a0a0a] w-full" id="main-nav">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center md:justify-center relative">
      
      <!-- Mobile/Tablet Brand Logo (Visible on mobile instead of top bar) -->
      <a href="/#inicio" class="flex items-center md:hidden group">
        <img 
          src="/images/logo-blanco.png" 
          alt="VisionCode Logo" 
          class="h-8 w-auto object-contain"
        />
      </a>

      <!-- Desktop Links (Centered on desktop) -->
      <nav class="hidden md:flex items-center gap-10">
        {links.map(link => (
          <a 
            href={link.href} 
            class="text-[0.68rem] font-bold uppercase tracking-widest text-white/70 hover:text-[#E8001C] transition-colors duration-200 relative group"
          >
            {link.text}
            <span class="absolute -bottom-1.5 left-0 w-0 h-[2px] bg-[#E8001C] group-hover:w-full transition-all duration-300"></span>
          </a>
        ))}
      </nav>

      <!-- Desktop CTA (Right aligned inside the black navbar, optional, we keep it subtle) -->
      <div class="hidden md:block absolute right-6">
        <a 
          href="/#contacto" 
          class="text-[0.62rem] font-black uppercase tracking-widest text-white bg-[#E8001C] hover:bg-[#B8000E] px-4.5 py-2 transition-all duration-200"
        >
          Cotizar
        </a>
      </div>

      <!-- Mobile Menu Button (Right aligned) -->
      <button 
        class="md:hidden text-white/75 hover:text-[#E8001C] transition-colors" 
        id="mobile-btn" 
        aria-label="Abrir menú"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="hidden md:hidden bg-[#0a0a0a] border-t border-[#E8001C]/30" id="mobile-menu">
    <div class="flex flex-col px-6 py-6 gap-5">
      {links.map(link => (
        <a 
          href={link.href} 
          class="text-xs font-bold uppercase tracking-widest text-white/70 hover:text-[#E8001C] transition-colors"
        >
          {link.text}
        </a>
      ))}
      <div class="h-px bg-white/5 my-2"></div>
      <!-- Contact inside mobile drawer -->
      <div class="flex flex-col gap-3 text-[0.7rem] text-white/50">
        <a href="https://api.whatsapp.com/send?phone=56929645522" target="_blank" class="hover:text-[#E8001C] transition-colors flex items-center gap-2">
          +56 9 2964 5522
        </a>
        <a href="mailto:Vision.code.vs@gmail.com" class="hover:text-[#E8001C] transition-colors flex items-center gap-2">
          Vision.code.vs@gmail.com
        </a>
      </div>
      <a href="/#contacto" class="text-center text-[0.68rem] font-black uppercase tracking-widest text-white bg-[#E8001C] hover:bg-[#B8000E] px-5 py-3 transition-all duration-200 mt-2">
        Contactar
      </a>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const navbar = document.getElementById('navbar');
  
  // Mobile toggle
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => mobileMenu.classList.add('hidden'));
  });

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (!navbar) return;
    const y = window.scrollY;
    if (y > 40) {
      navbar.style.boxShadow = '0 10px 30px rgba(0,0,0,0.15)';
    } else {
      navbar.style.boxShadow = 'none';
    }
  });
</script>
