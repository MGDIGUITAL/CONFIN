---
---
<section id="inicio" class="relative w-full min-h-screen flex flex-col overflow-hidden bg-white">

  <!-- Navbar spacer -->
  <div class="h-[64px] md:h-[140px] shrink-0"></div>

  <!-- Main Hero Content -->
  <div class="flex-1 flex items-center">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 w-full">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-0 items-center min-h-[calc(100vh-60px)]">

        <!-- LEFT: Text Content -->
        <div class="flex flex-col justify-center py-16 lg:py-0 fade-up">

          <!-- Label -->
          <div class="flex items-center gap-3.5 mb-6 opacity-0 translate-x-[-15px] animate-slide-in">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#E8001C] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#E8001C]"></span>
            </span>
            <span class="text-xs md:text-[0.8rem] font-black uppercase tracking-[0.25em] shimmer-text select-none">
              MARKETING DIGITAL & INGENIERÍA
            </span>
          </div>

          <!-- Headline -->
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black leading-[1.0] tracking-tight text-black mb-2 min-h-[1em] select-none" id="hero-title">
            Vision Code
          </h1>
          <h2 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-black leading-[1.1] tracking-tight text-[#E8001C] mb-6 select-none h-[1.3em] relative overflow-hidden" id="hero-subtitle-container">
            <span id="rotate-text" class="absolute left-0 top-0 w-full h-full flex items-center opacity-0 translate-y-[30px] transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
              Marketing Digital
            </span>
          </h2>

          <!-- Red accent bar -->
          <div class="w-1 h-12 bg-[#E8001C] mb-8"></div>

          <!-- Description -->
          <p class="text-base text-black/70 max-w-md leading-relaxed mb-4 font-medium">
            Fusionamos marketing digital avanzado y diseño web con ingeniería de software de élite. Creamos plataformas e-commerce, integraciones automatizadas y sistemas a medida (SaaS / ERP).
          </p>
          <p class="text-base text-black/80 max-w-md leading-relaxed mb-10">
            Tenemos la tecnología para optimizar tus procesos, <strong class="text-black font-bold">la precisión para escalar tu facturación y automatizar tu negocio.</strong>
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contacto" class="inline-flex items-center gap-3 bg-[#E8001C] hover:bg-[#B8000E] text-white font-black text-sm uppercase tracking-widest px-8 py-4 transition-all duration-200 group w-fit">
              Contactar
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="#servicios" class="inline-flex items-center gap-3 border-2 border-black/20 text-black hover:border-[#E8001C] hover:text-[#E8001C] font-bold text-sm uppercase tracking-widest px-8 py-4 transition-all duration-200 w-fit">
              Ver Servicios
            </a>
          </div>
        </div>

        <!-- RIGHT: Círculo + logo rompiendo por arriba -->
        <div class="flex items-center justify-center lg:justify-end relative py-24 lg:py-0">
          <div class="circle-scene">

            <!-- Anillo exterior punteado animado -->
            <div class="ring-outer"></div>

            <!-- Círculo rojo principal con el logo adentro -->
            <div class="circle-main">
              <img
                src="/images/logo-negro.png"
                alt="VisionCode – Agencia de Marketing Digital"
                class="w-[95%] h-auto object-contain drop-shadow-sm"
                loading="eager"
              />
            </div>

            <!-- Puntos decorativos -->
            <div class="absolute top-6 right-4 w-4 h-4 rounded-full bg-[#E8001C]"></div>
            <div class="absolute bottom-10 left-4 w-3 h-3 rounded-full bg-[#E8001C] opacity-50"></div>
            <div class="absolute -bottom-5 -right-5 w-16 h-16 rounded-full border-[4px] border-[#E8001C] opacity-20"></div>

          </div>
        </div>

      </div>
  </div>

</section>iv>

</section>

<style>
  /* ── Escena del círculo ─────────────────────────── */
  .circle-scene {
    position: relative;
    width: 420px;
    height: 420px;
  }

  /* Círculo rojo principal */
  .circle-main {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 6px solid #E8001C;
    background-color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.95;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
  }

  /* Anillo exterior punteado giratorio */
  .ring-outer {
    position: absolute;
    inset: -30px;
    border-radius: 50%;
    border: 2px dashed rgba(232, 0, 28, 0.2);
    animation: spin 26s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 1024px) {
    .circle-scene  { width: 340px; height: 340px; }
  }
  @media (max-width: 640px) {
    .circle-scene  { width: 270px; height: 270px; }
  }

  /* ── Animación fade-up ──────────────────────────── */
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fade-up {
    opacity: 0;
    animation: heroFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  /* ── Shimmer & Slide para el Label ──────────────── */
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  @keyframes slideIn {
    to { opacity: 1; transform: translateX(0); }
  }
  .shimmer-text {
    background: linear-gradient(90deg, #E8001C 0%, #FF4D61 50%, #E8001C 100%);
    background-size: 200% auto;
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    animation: shimmer 3.5s linear infinite;
  }
  .animate-slide-in {
    animation: slideIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }
</style>

<script>
  function animateTitle(id: string, startDelay: number) {
    const el = document.getElementById(id);
    if (!el) return;
    const text = el.textContent ? el.textContent.trim() : "";
    el.innerHTML = "";
    
    const chars = Array.from(text);
    chars.forEach((char, i) => {
      const span = document.createElement('span');
      if (char === ' ') {
        span.innerHTML = '&nbsp;';
      } else {
        span.textContent = char;
      }
      span.style.display = 'inline-block';
      span.style.opacity = '0';
      span.style.transform = 'translateY(25px) rotate(2deg)';
      span.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
      el.appendChild(span);
      
      setTimeout(() => {
        span.style.opacity = '1';
        span.style.transform = 'translateY(0) rotate(0deg)';
      }, startDelay + (i * 35));
    });
  }

  function initTextRotation() {
    const rotateEl = document.getElementById('rotate-text');
    if (!rotateEl) return;

    // Primer reveal del subtítulo
    setTimeout(() => {
      rotateEl.style.opacity = '1';
      rotateEl.style.transform = 'translateY(0)';
    }, 600);

    // Lista de frases a rotar
    const phrases = [
      "Marketing Digital",
      "Soluciones Digitales",
      "Diseño Web",
      "Agencia Digital"
    ];
    let currentIndex = 0;

    function rotateWord() {
      if (!rotateEl) return;
      
      // Deslizar hacia arriba y desaparecer
      rotateEl.style.opacity = '0';
      rotateEl.style.transform = 'translateY(-30px)';
      
      setTimeout(() => {
        // Cambiar palabra y reposicionar abajo
        currentIndex = (currentIndex + 1) % phrases.length;
        rotateEl.textContent = phrases[currentIndex];
        rotateEl.style.transform = 'translateY(30px)';
        
        // Transición de entrada (deslizar hacia el centro y aparecer)
        requestAnimationFrame(() => {
          setTimeout(() => {
            rotateEl.style.opacity = '1';
            rotateEl.style.transform = 'translateY(0)';
          }, 50);
        });
      }, 500);
    }

    // Iniciar el ciclo de rotación después de la carga inicial
    setTimeout(() => {
      setInterval(rotateWord, 3200);
    }, 1500);
  }

  // Inicializar al cargar el DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      animateTitle('hero-title', 150);
      initTextRotation();
    });
  } else {
    animateTitle('hero-title', 150);
    initTextRotation();
  }
</script>
