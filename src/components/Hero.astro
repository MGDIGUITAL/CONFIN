---
---
<section id="inicio" class="relative w-full min-h-screen flex flex-col overflow-hidden bg-neutral-950 text-white">

  <!-- Background carousel -->
  <div class="absolute inset-0 z-0 overflow-hidden select-none pointer-events-none">
    <div id="hero-bg-1" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100" style="background-image: url('/images/hero-bg-1.jpeg');"></div>
    <div id="hero-bg-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-bg-2.jpeg');"></div>
    <div id="hero-bg-3" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-bg-3.jpeg');"></div>
    <div id="hero-bg-4" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-bg-4.jpeg');"></div>
    <div id="hero-bg-5" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-bg-5.jpeg');"></div>
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-black/60 md:bg-black/55 backdrop-blur-[0.5px]"></div>
  </div>

  <!-- Navbar spacer -->
  <div class="h-[64px] md:h-[140px] shrink-0"></div>

  <!-- Main Hero Content -->
  <div class="flex-1 flex items-center relative z-10">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 w-full">
      <div class="flex items-center min-h-[calc(100vh-60px)]">

        <!-- LEFT: Text Content -->
        <div class="flex flex-col justify-center py-16 lg:py-0 fade-up max-w-2xl">

          <!-- Label -->
          <div class="flex items-center gap-3 mb-6 opacity-0 translate-x-[-15px] animate-slide-in">
            <span class="text-xs md:text-[0.8rem] font-black uppercase tracking-[0.25em] text-[#E8001C] select-none">
              MARKETING DIGITAL & INGENIERÍA
            </span>
          </div>

          <!-- Headline -->
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black leading-[1.0] tracking-tight text-white mb-2 min-h-[1em] select-none" id="hero-title">
            Vision Code
          </h1>
          <h2 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-black leading-[1.1] tracking-tight text-[#E8001C] mb-10 select-none flex items-start flex-wrap min-h-[2.4em] lg:min-h-[1.3em]" id="hero-subtitle-container">
            <span id="rotate-text" class="relative">Marketing Digital.</span><span class="typewriter-cursor text-[#E8001C] ml-1">|</span>
          </h2>

          <!-- Description -->
          <p class="text-base text-white max-w-md leading-relaxed mb-4 font-medium">
            Ayudamos a tu negocio a vender más y a funcionar en piloto automático. Creamos páginas web profesionales, tiendas online fáciles de usar y sistemas digitales a medida para tu empresa.
          </p>
          <p class="text-base text-white max-w-md leading-relaxed mb-10">
            Optimizamos tu marketing digital y automatizamos tu atención al cliente, <strong class="text-white font-bold">multiplicando tus ventas sin que tengas que trabajar más horas.</strong>
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 relative z-20">
            <a href="#contacto" class="relative overflow-hidden inline-flex items-center gap-3 bg-[#E8001C] text-white font-black text-sm uppercase tracking-widest px-8 py-4 group w-fit transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(232,0,28,0.35)]">
              <!-- Background slide overlay -->
              <span class="absolute inset-0 bg-[#B8000E] translate-x-[-101%] group-hover:translate-x-0 transition-transform duration-[400ms] ease-[cubic-bezier(0.16,1,0.3,1)] z-0"></span>
              <span class="relative z-10 flex items-center gap-3">
                Contactar
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1.5 transition-transform duration-300">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
            <a href="#servicios" class="relative overflow-hidden inline-flex items-center gap-3 border-2 border-white/20 text-white font-bold text-sm uppercase tracking-widest px-8 py-4 group w-fit transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(255,255,255,0.1)]">
              <!-- Background slide overlay -->
              <span class="absolute inset-0 bg-white translate-y-[101%] group-hover:translate-y-0 transition-transform duration-[400ms] ease-[cubic-bezier(0.16,1,0.3,1)] z-0"></span>
              <span class="relative z-10 group-hover:text-black transition-colors duration-[400ms]">Ver Servicios</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

</section>

<style>
  /* ── Animación fade-up ──────────────────────────── */
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fade-up {
    opacity: 0;
    animation: heroFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  /* ── Slide para el Label ──────────────── */
  @keyframes slideIn {
    to { opacity: 1; transform: translateX(0); }
  }
  .animate-slide-in {
    animation: slideIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }
</style>

<script>
  function animateTitle(id: string, startDelay: number) {
    const el = document.getElementById(id);
    if (!el) return;
    const text = el.textContent ? el.textContent.trim() : "";
    el.innerHTML = "";
    
    const chars = Array.from(text);
    chars.forEach((char, i) => {
      const span = document.createElement('span');
      if (char === ' ') {
        span.innerHTML = '&nbsp;';
      } else {
        span.textContent = char;
      }
      span.style.display = 'inline-block';
      span.style.opacity = '0';
      span.style.transform = 'translateY(25px) rotate(2deg)';
      span.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
      el.appendChild(span);
      
      setTimeout(() => {
        span.style.opacity = '1';
        span.style.transform = 'translateY(0) rotate(0deg)';
      }, startDelay + (i * 35));
    });
  }

  import { setupTypewriter } from '../utils/rotator';

  function initHeroCarousel() {
    const bgElements = [
      document.getElementById('hero-bg-1'),
      document.getElementById('hero-bg-2'),
      document.getElementById('hero-bg-3'),
      document.getElementById('hero-bg-4'),
      document.getElementById('hero-bg-5')
    ];

    const bgs = bgElements.filter(el => el !== null) as HTMLElement[];
    if (bgs.length <= 1) return;

    let currentIndex = 0;

    setInterval(() => {
      // Hide current background
      bgs[currentIndex].style.opacity = '0';
      // Calculate next index
      currentIndex = (currentIndex + 1) % bgs.length;
      // Show next background
      bgs[currentIndex].style.opacity = '1';
    }, 4000);
  }

  // Inicializar al cargar el DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      animateTitle('hero-title', 150);
      setupTypewriter('rotate-text', ["Marketing Digital.", "Crea tu E-Commerce.", "Todo tipo de soluciones Digitales.", "Te ayudamos a potenciar tu Marca.", "Desarrollo WEB a medida."], 600);
      initHeroCarousel();
    });
  } else {
    animateTitle('hero-title', 150);
    setupTypewriter('rotate-text', ["Marketing Digital.", "Crea tu E-Commerce.", "Todo tipo de soluciones Digitales.", "Te ayudamos a potenciar tu Marca.", "Desarrollo WEB a medida."], 600);
    initHeroCarousel();
  }
</script>
