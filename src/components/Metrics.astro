---
const metrics = [
  {
    value: "75%",
    label: "Credibilidad Inmediata",
    desc: "De los consumidores juzgan la confianza y reputación de una empresa basándose exclusivamente en su diseño web."
  },
  {
    value: "93%",
    label: "Decisiones de Compra",
    desc: "De los procesos de adquisición (B2B y B2C) comienzan buscando la autoridad digital y presencia en línea de la marca."
  },
  {
    value: "+80%",
    label: "Crecimiento en Ventas",
    desc: "Incremento promedio de conversión al implementar tiendas E-Commerce y agentes de Inteligencia Artificial en WhatsApp."
  },
  {
    value: "-40%",
    label: "Costos Operativos",
    desc: "Reducción de horas-hombre al automatizar procesos integrando un ERP a medida con los canales de venta digitales."
  }
];
---

<section id="metricas" class="py-24 relative z-10 bg-black/80 border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-8">
      {metrics.map((m, i) => (
        <div class="flex flex-col border-l border-white/10 pl-6 fade-up" style={`transition-delay: ${i * 0.1}s`}>
          <div class="text-5xl md:text-6xl font-black text-white tracking-tighter mb-2">
            {m.value}
          </div>
          <h4 class="text-sm font-bold uppercase tracking-widest text-[#8B1A2B] mb-3">
            {m.label}
          </h4>
          <p class="text-xs text-white/50 leading-relaxed font-light">
            {m.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
