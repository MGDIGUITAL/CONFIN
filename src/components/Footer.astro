---
const year = new Date().getFullYear();
---

<footer class="relative z-10 pt-0 pb-10 px-6 lg:px-10 bg-white border-t border-[#1B3C9C]/15" id="footer">
  
  <!-- Línea institucional superior CONFIN CAPITAL -->
  <div class="h-[3px] w-full bg-gradient-to-r from-[#122878] via-[#5B9BE6] to-[#122878] mb-16"></div>

  <div class="max-w-7xl mx-auto">
    
    <!-- Top: Logo + Links -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-10 mb-14">
      
      <!-- Brand -->
      <div class="flex items-center">
        <img 
          src="/images/confin-logo.png" 
          alt="CONFIN CAPITAL Logo" 
          class="h-44 md:h-52 w-auto object-contain my-[-40px] select-none" 
        />
      </div>

      <!-- Nav Links -->
      <nav class="flex flex-wrap gap-x-10 gap-y-4">
        <a href="/#servicios" class="text-xs font-extrabold uppercase tracking-widest text-[#1B3C9C] hover:text-[#122878] transition-colors">Soluciones</a>
        <a href="/#ventajas" class="text-xs font-extrabold uppercase tracking-widest text-[#1B3C9C] hover:text-[#122878] transition-colors">Ventajas</a>
        <a href="/#proceso" class="text-xs font-extrabold uppercase tracking-widest text-[#1B3C9C] hover:text-[#122878] transition-colors">Proceso</a>
        <a href="/tienda" class="text-xs font-extrabold uppercase tracking-widest text-[#1B3C9C] hover:text-[#122878] transition-colors">Portafolio</a>
        <a href="/#contacto" class="text-xs font-extrabold uppercase tracking-widest text-white bg-[#1B3C9C] hover:bg-[#122878] px-4 py-2 rounded-sm transition-colors">Contacto</a>
      </nav>
    </div>

    <!-- Bottom Divider -->
    <div class="border-t border-[#1B3C9C]/15 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-xs text-[#122878]/80 uppercase tracking-widest font-semibold">
        &copy; {year} CONFIN CAPITAL. Todos los derechos reservados.
      </div>
      <div class="flex gap-6 text-xs text-[#1B3C9C] uppercase tracking-widest font-bold">
        <a href="/politicas" class="hover:text-[#122878] transition-colors">Políticas</a>
        <a href="https://web.facebook.com/profile.php?id=61591906443953&locale=es_LA" target="_blank" rel="noopener noreferrer" class="hover:text-[#122878] transition-colors">Facebook</a>
        <a href="https://api.whatsapp.com/send?phone=56920836337" target="_blank" rel="noopener noreferrer" class="hover:text-[#122878] transition-colors">WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
