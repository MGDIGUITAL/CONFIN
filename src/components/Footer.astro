---
const year = new Date().getFullYear();
---

<footer class="relative z-10 pt-0 pb-10 px-6 lg:px-10 bg-black border-t-0" id="footer">
  
  <!-- Línea roja superior Vision Code -->
  <div class="h-[3px] w-full bg-gradient-to-r from-[#B8000E] via-[#E8001C] to-[#B8000E] mb-16"></div>

  <div class="max-w-7xl mx-auto">
    
    <!-- Top: Logo + Links -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-10 mb-14">
      
      <!-- Brand -->
      <div class="flex items-center">
        <img 
          src="/images/logo-blanco.png" 
          alt="VisionCode Logo" 
          class="h-48 md:h-56 w-auto object-contain my-[-45px] select-none" 
        />
      </div>

      <!-- Nav Links -->
      <nav class="flex flex-wrap gap-x-10 gap-y-4">
        <a href="/#servicios" class="text-xs font-bold uppercase tracking-widest text-white/50 hover:text-[#E8001C] transition-colors">Soluciones</a>
        <a href="/#impacto" class="text-xs font-bold uppercase tracking-widest text-white/50 hover:text-[#E8001C] transition-colors">Impacto</a>
        <a href="/tienda" class="text-xs font-bold uppercase tracking-widest text-white/50 hover:text-[#E8001C] transition-colors">Servicios</a>
        <a href="/#contacto" class="text-xs font-bold uppercase tracking-widest text-[#E8001C] hover:text-white transition-colors">Contacto</a>
      </nav>
    </div>

    <!-- Bottom Divider -->
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-xs text-white/30 uppercase tracking-widest">
        &copy; {year} Vision Code. Todos los derechos reservados.
      </div>
      <div class="flex gap-6 text-xs text-white/40 uppercase tracking-widest font-bold">
        <a href="/politicas" class="hover:text-[#E8001C] transition-colors">Políticas</a>
        <a href="https://web.facebook.com/profile.php?id=61591906443953&locale=es_LA" target="_blank" rel="noopener noreferrer" class="hover:text-[#E8001C] transition-colors">Facebook</a>
        <a href="https://api.whatsapp.com/send?phone=56929645522" target="_blank" rel="noopener noreferrer" class="hover:text-[#E8001C] transition-colors">WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
