---
---

<section id="impacto" class="py-40 relative z-10 overflow-hidden bg-neutral-950 text-white animate-fade-in">
  
  <!-- Background carousel -->
  <div class="absolute inset-0 z-0 overflow-hidden select-none pointer-events-none">
    <div id="project-bg-1" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100" style="background-image: url('/images/hero-bg-4.jpeg');"></div>
    <div id="project-bg-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-bg-5.jpeg');"></div>
    <div id="project-bg-3" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-bg-1.jpeg');"></div>
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-black/80 backdrop-blur-[1px]"></div>
  </div>

  <div class="max-w-[90rem] mx-auto px-6 lg:px-12 relative z-10">
    
    <div class="flex flex-col md:flex-row justify-between items-end gap-10 mb-28 fade-up">
      <div class="max-w-4xl">
        <div class="saas-badge border-none text-[#E8001C] bg-transparent font-bold tracking-[0.2em] text-[0.7rem] px-0 uppercase mb-6">El Valor de lo Digital</div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-8">
          Tu presencia en la web es <br/>
          <span class="h-[1.2em] relative overflow-hidden w-full text-[#E8001C] block select-none">
            <span id="rotate-project-text" class="absolute left-0 top-0 w-full h-full flex items-center whitespace-nowrap opacity-0 translate-y-[30px] transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
              tu activo más importante.
            </span>
          </span>
        </h2>
        <p class="text-xl text-white/70 font-light leading-relaxed max-w-3xl">
          Dejamos atrás las plantillas genéricas para construir <strong class="text-white font-bold">tecnología de alta fidelidad</strong>. Desarrollamos infraestructura web de alto rendimiento y sistemas a medida diseñados estratégicamente para consolidar la autoridad de tu marca, automatizar tus procesos internos y acelerar tu conversión con precisión de ingeniería.
        </p>
      </div>
    </div>

    <!-- Editorial Bento Grid for Business Pitch -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 auto-rows-[minmax(240px,auto)]">
      
      <!-- Card 1 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 flex flex-col justify-between group fade-up relative overflow-hidden bg-[#0a0a0a]/80 border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0s">
        <div class="relative z-10 max-w-2xl">
          <h3 class="text-3xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Optimización Orientada a Ventas (CRO)</h3>
          <p class="text-lg text-white/60 leading-relaxed font-light">
            Un sitio web que no vende es solo un gasto. Implementamos estrategias avanzadas de conversión, velocidades de carga ultra-rápidas y SEO técnico para asegurar que cada visita tenga la más alta probabilidad de convertirse en un cliente real para tu empresa.
          </p>
        </div>
      </article>

      <!-- Card 2 (Span 1) -->
      <article class="bento-card p-10 md:p-12 flex flex-col justify-between group fade-up bg-[#0a0a0a]/80 border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0.15s">
        <div class="relative z-10">
          <h3 class="text-2xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Desarrollo <br/> Full Stack</h3>
          <p class="text-base text-white/60 leading-relaxed font-light">
            Dominamos tanto la interfaz visible (Frontend interactivo) como la lógica y bases de datos detrás (Backend). Esto nos permite crear sistemas 100% a medida, seguros y del más alto estándar.
          </p>
        </div>
      </article>

      <!-- Card 3 (Span 1) -->
      <article class="bento-card p-10 md:p-12 flex flex-col justify-between group fade-up bg-[#0a0a0a]/80 border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0.3s">
        <div class="relative z-10">
          <h3 class="text-2xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Autoridad <br/> y Confianza 24/7</h3>
          <p class="text-base text-white/60 leading-relaxed font-light">
            Tu portal web es tu vendedor más incansable. Proyecta un nivel corporativo impecable que genera confianza instantánea y diferencia claramente tu marca de la competencia.
          </p>
        </div>
      </article>

      <!-- Card 4 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 flex flex-col justify-between group fade-up relative overflow-hidden bg-[#0a0a0a]/80 border border-white/5 hover:border-[#E8001C]/30 shadow-md hover:shadow-[0_20px_50px_rgba(232,0,28,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0.45s">
        <div class="relative z-10">
          <h3 class="text-3xl font-bold text-white mb-4 tracking-tight group-hover:text-[#E8001C] transition-colors duration-300">Sistemas Internos e Inteligencia Artificial</h3>
          <p class="text-lg text-white/60 leading-relaxed font-light">
            Vamos mucho más allá del diseño web. Integramos Inteligencia Artificial para atención al cliente automática (vía web y WhatsApp) y desarrollamos sistemas a medida que conectan tus ventas online con la logística y el inventario real de tu negocio.
          </p>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  #impacto .bento-card {
    background: rgba(10, 10, 10, 0.8) !important;
    border-color: rgba(255, 255, 255, 0.05) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4) !important;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  #impacto .bento-card:hover {
    border-color: rgba(232, 0, 28, 0.3) !important;
    box-shadow: 0 20px 50px rgba(232, 0, 28, 0.15) !important;
  }
  #impacto .bento-card::after {
    display: none !important;
  }
</style>

<script>
  import { setupTextRotation } from '../utils/rotator';

  const phrases = [
    "tu activo más importante.",
    "tu mejor inversión.",
    "tu vendedor 24/7.",
    "tu motor de crecimiento."
  ];

  function initProjectCarousel() {
    const bgs = [
      document.getElementById('project-bg-1'),
      document.getElementById('project-bg-2'),
      document.getElementById('project-bg-3')
    ];
    if (!bgs[0]) return;
    let currentIndex = 0;
    setInterval(() => {
      bgs[currentIndex].style.opacity = '0';
      currentIndex = (currentIndex + 1) % bgs.length;
      bgs[currentIndex].style.opacity = '1';
    }, 4500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupTextRotation('rotate-project-text', phrases, 800);
      initProjectCarousel();
    });
  } else {
    setupTextRotation('rotate-project-text', phrases, 800);
    initProjectCarousel();
  }
</script>
