---
---

<section id="ventajas" class="py-40 relative z-10 overflow-hidden bg-neutral-950 text-white animate-fade-in">
  
  <!-- Background carousel -->
  <div class="absolute inset-0 z-0 overflow-hidden select-none pointer-events-none">
    <div id="project-bg-1" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100" style="background-image: url('/images/hero-fogain-fianzas.png');"></div>
    <div id="project-bg-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-leasing-activos.png');"></div>
    <div id="project-bg-3" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0" style="background-image: url('/images/hero-factoring-comex.png');"></div>
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-black/80 backdrop-blur-[1px]"></div>
  </div>

  <div class="max-w-[90rem] mx-auto px-6 lg:px-12 relative z-10">
    
    <div class="flex flex-col md:flex-row justify-between items-end gap-10 mb-28 fade-up">
      <div class="max-w-4xl">
        <div class="saas-badge border-none text-[#1B3C9C] bg-transparent font-bold tracking-[0.2em] text-[0.7rem] px-0 uppercase mb-6">La Ventaja de Trabajar con Nosotros</div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1] mb-8">
          Su capital merece <br/>
          <span class="h-[1.2em] relative overflow-hidden w-full text-[#1B3C9C] block select-none">
            <span id="rotate-project-text" class="absolute left-0 top-0 w-full h-full flex items-center whitespace-nowrap opacity-0 translate-y-[30px] transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
              un aliado estratégico.
            </span>
          </span>
        </h2>
        <p class="text-xl text-white/70 font-light leading-relaxed max-w-3xl">
          ConFin Capital opera como <strong class="text-white font-bold">puente estratégico e imparcial</strong> entre su necesidad de financiamiento y la entidad financiera idónea, ejecutando un análisis exhaustivo del mercado para diseñar, negociar y gestionar estructuras de crédito, liquidez y cobertura con máxima eficiencia de costos y agilidad.
        </p>
      </div>
    </div>

    <!-- Editorial Bento Grid for Business Pitch -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 auto-rows-[minmax(240px,auto)]">
      
      <!-- Card 1 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 flex flex-col justify-between group fade-up relative overflow-hidden bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0s">
        <div class="relative z-10 max-w-2xl">
          <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">VENTAJA COMPETITIVA</span>
          <h3 class="text-3xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Experiencia & Relaciones Institucionales</h3>
          <p class="text-lg text-slate-700 leading-relaxed font-normal">
            El conocimiento directo de los procesos de cada entidad financiera nos permite <strong class="text-[#122878] font-bold">saltarnos pasos innecesarios</strong> y presentar su información de manera que sea aprobada con rapidez, evitando rondas de correcciones que consumen semanas críticas.
          </p>
        </div>
      </article>

      <!-- Card 2 (Span 1) -->
      <article class="bento-card p-10 md:p-12 flex flex-col justify-between group fade-up bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0.15s">
        <div class="relative z-10">
          <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">PRECISIÓN DOCUMENTAL</span>
          <h3 class="text-2xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Conocimiento<br/>Documental Exacto</h3>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Sabemos exactamente qué documentos se necesitan para cada tipo de financiamiento, eliminando retrasos por información faltante o incorrecta que paralizan las aprobaciones.
          </p>
        </div>
      </article>

      <!-- Card 3 (Span 1) -->
      <article class="bento-card p-10 md:p-12 flex flex-col justify-between group fade-up bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0.3s">
        <div class="relative z-10">
          <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">INDEPENDENCIA INSTITUCIONAL</span>
          <h3 class="text-2xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Negociación<br/>Ágil & Multioferta</h3>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Al gestionar múltiples opciones simultáneamente, podemos presionar por plazos de respuesta más cortos y negociar las condiciones más competitivas del mercado para su operación.
          </p>
        </div>
      </article>

      <!-- Card 4 (Span 2) -->
      <article class="bento-card md:col-span-2 p-10 md:p-12 flex flex-col justify-between group fade-up relative overflow-hidden bg-white border border-[#1B3C9C]/15 hover:border-[#1B3C9C]/50 shadow-md hover:shadow-[0_20px_50px_rgba(27,60,156,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2" style="transition-delay: 0.45s">
        <div class="relative z-10">
          <span class="inline-block text-[0.65rem] font-extrabold tracking-widest uppercase text-[#1B3C9C] mb-2">LIQUIDEZ INMEDIATA</span>
          <h3 class="text-3xl font-bold text-[#1B3C9C] mb-4 tracking-tight group-hover:text-[#122878] transition-colors duration-300">Productos de Rápida Resolución para Capital Urgente</h3>
          <p class="text-lg text-slate-700 leading-relaxed font-normal">
            Instrumentos como el <strong class="text-[#122878] font-bold">Factoring Corporativo</strong> o el <strong class="text-[#122878] font-bold">Capital de Trabajo</strong> son inherentemente más rápidos de gestionar que un crédito hipotecario. Los utilizamos estratégicamente para inyectar liquidez inmediata cuando su operación no puede esperar.
          </p>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  #ventajas .bento-card {
    background: #ffffff !important;
    border-color: rgba(27, 60, 156, 0.15) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;
  }
  #ventajas .bento-card:hover {
    border-color: rgba(27, 60, 156, 0.45) !important;
    box-shadow: 0 20px 50px rgba(27, 60, 156, 0.15) !important;
  }
</style>

<script>
  import { setupTextRotation } from '../utils/rotator';

  const phrases = [
    "un aliado estratégico.",
    "gestión ágil y eficiente.",
    "independencia institucional.",
    "la máxima rentabilidad."
  ];

  function initProjectCarousel() {
    const bgs = [
      document.getElementById('project-bg-1'),
      document.getElementById('project-bg-2'),
      document.getElementById('project-bg-3')
    ];
    if (!bgs[0]) return;
    let currentIndex = 0;
    setInterval(() => {
      bgs[currentIndex].style.opacity = '0';
      currentIndex = (currentIndex + 1) % bgs.length;
      bgs[currentIndex].style.opacity = '1';
    }, 4500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupTextRotation('rotate-project-text', phrases, 800);
      initProjectCarousel();
    });
  } else {
    setupTextRotation('rotate-project-text', phrases, 800);
    initProjectCarousel();
  }
</script>
