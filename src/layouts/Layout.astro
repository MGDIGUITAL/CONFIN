---
import SalesAgent from '../components/SalesAgent.astro';
export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Vision Code — Agencia de Marketing Digital",
  description = "Soluciones tecnológicas corporativas, sistemas de gestión y plataformas e-commerce de alto rendimiento."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Vision Code" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#E8001C" />
    <link rel="icon" type="image/png" href="/images/logo-negro.png" />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700;1,900&family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <!-- Global Styles -->
    <style is:global>
      :root {
        /* ─── Paleta Vision Code: Blanco + Rojo + Negro ─── */
        --saas-bg:            #ffffff;
        --saas-bg-alt:        #F6F6F6;
        --saas-bg-dark:       #0a0a0a;
        --saas-surface:       #ffffff;
        --saas-surface-hover: rgba(232, 0, 28, 0.04);
        --saas-border:        rgba(0, 0, 0, 0.09);
        --saas-border-hover:  rgba(232, 0, 28, 0.55);
        --saas-brand:         #E8001C;
        --saas-brand-light:   #FF1A2E;
        --saas-brand-dark:    #B8000E;
        --saas-text:          #0a0a0a;
        --saas-text-muted:    rgba(0, 0, 0, 0.50);
        --saas-text-subtle:   rgba(0, 0, 0, 0.28);
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background-color: var(--saas-bg);
        color: var(--saas-text);
        font-family: 'Montserrat', 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
        letter-spacing: -0.01em;
      }

      ::selection { background: var(--saas-brand); color: #fff; }
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: #f0f0f0; }
      ::-webkit-scrollbar-thumb { background: rgba(232, 0, 28, 0.4); }
      ::-webkit-scrollbar-thumb:hover { background: rgba(232, 0, 28, 0.8); }

      /* ── Cards blancas con hover rojo ── */
      .bento-card {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 0;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
        z-index: 10;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
      }
      .bento-card:hover {
        border-color: rgba(232, 0, 28, 0.45);
        box-shadow: 0 8px 32px rgba(232, 0, 28, 0.10);
        transform: translateY(-3px);
      }
      .bento-card::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: #E8001C;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .bento-card:hover::after { opacity: 1; }

      /* ── Badges ── */
      .saas-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.65rem;
        background: rgba(232, 0, 28, 0.07);
        border: 1px solid rgba(232, 0, 28, 0.28);
        border-radius: 0;
        font-size: 0.6rem;
        font-weight: 800;
        font-family: 'Montserrat', sans-serif;
        color: var(--saas-brand);
        text-transform: uppercase;
        letter-spacing: 0.18em;
      }

      /* ── Botón rojo principal ── */
      .btn-primary {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        background: var(--saas-brand);
        color: #ffffff;
        font-weight: 800;
        font-size: 0.72rem;
        padding: 0.9rem 2.2rem;
        border-radius: 0;
        transition: all 0.22s ease;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        border: 2px solid var(--saas-brand);
        font-family: 'Montserrat', sans-serif;
        cursor: pointer;
      }
      .btn-primary:hover {
        background: var(--saas-brand-dark);
        border-color: var(--saas-brand-dark);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(232, 0, 28, 0.35);
      }

      /* ── Botón outline negro (para fondos blancos) ── */
      .btn-secondary {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        background: transparent;
        color: #0a0a0a;
        font-weight: 700;
        font-size: 0.72rem;
        padding: 0.9rem 2.2rem;
        border-radius: 0;
        border: 2px solid rgba(0,0,0,0.22);
        transition: all 0.22s ease;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-family: 'Montserrat', sans-serif;
        cursor: pointer;
      }
      .btn-secondary:hover {
        border-color: var(--saas-brand);
        color: var(--saas-brand);
        transform: translateY(-1px);
      }

      /* ── Sección oscura (contraste) ── */
      .section-dark {
        background: #0a0a0a;
        color: #ffffff;
      }
      .section-dark .bento-card {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.08);
      }
      .section-dark .bento-card:hover {
        background: rgba(232,0,28,0.06);
        border-color: rgba(232,0,28,0.4);
      }
      .section-dark p,
      .section-dark span,
      .section-dark li {
        color: rgba(255,255,255,0.7);
      }

      /* ── Sección gris clara ── */
      .section-light {
        background: var(--saas-bg-alt);
      }

      /* ── Marquee animado ── */
      @keyframes marquee {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }
      .animate-marquee {
        animation: marquee 28s linear infinite;
        will-change: transform;
      }

      /* ── Reveal Animations ── */
      .fade-up {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .fade-up.in-view { opacity: 1; transform: translateY(0); }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    </script>
    <SalesAgent />
  </body>
</html>
